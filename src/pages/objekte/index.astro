---
import Breadcrumbs from "../../components/navigation/Breadcrumbs.astro";
import Layout from "../../layouts/Layout.astro";
import { pageTitle } from "../../data/site";
import { getReadingOrder } from "../../lib/content";
import { markdownToPlainText } from "../../lib/markdown";
import { getObjectOverview } from "../../lib/object-overview";

const [objects, readingOrder] = await Promise.all([getObjectOverview(), getReadingOrder()]);

type PageFilterGroup = {
  label: string;
  options: Array<{ label: string; value: string }>;
};

const sectionFilterGroups: PageFilterGroup[] = [];
let currentSectionGroup: PageFilterGroup | undefined;

for (const page of readingOrder) {
  const pageNumber = page.href.split("/").filter(Boolean).at(-1) ?? "";

  if (page.kind === "chapter") {
    const chapterTitle = markdownToPlainText(page.label);
    currentSectionGroup = {
      label: `Kapitel ${pageNumber}: ${chapterTitle}`,
      options: [{ label: `Gesamtes Kapitel ${pageNumber}: ${chapterTitle}`, value: `chapter:${pageNumber}` }],
    };
    sectionFilterGroups.push(currentSectionGroup);
  } else {
    currentSectionGroup?.options.push({
      label: `${pageNumber} ${markdownToPlainText(page.label)}`,
      value: `page:${page.href}`,
    });
  }
}
const standalonePages = new Map<string, string>();

for (const object of objects) {
  for (const usage of object.usages) {
    if (!usage.sectionNumber) standalonePages.set(usage.href.split("#")[0], usage.page);
  }
}

const standalonePageOptions = [...standalonePages].map(([href, label]) => ({ label, value: `page:${href}` }));
const pageFilterKeysByObject = new Map(objects.map((object) => [
  object.href,
  [...new Set(object.usages.flatMap((usage) => {
    const pageHref = usage.href.split("#")[0];
    const chapterNumber = usage.sectionNumber?.split(".")[0];
    return chapterNumber ? [`chapter:${chapterNumber}`, `page:${pageHref}`] : [`page:${pageHref}`];
  }))].join(" "),
]));

const dataColumns = [
  ["imageData", "Bilddaten"],
  ["systemData", "Systemdaten"],
] as const;

const columnOptions = [
  ["thumbnail", "Bild"],
  ["object", "Objekt"],
  ["usages", "Verlinkung / Beschriftung"],
  ["metadata", "Objektdaten"],
  ...dataColumns,
] as const;
const defaultHiddenColumns = new Set([
  "imageData",
  "systemData",
]);
---

<Layout
  title={`Objektübersicht. ${pageTitle}`}
  description="Objektübersicht der virtuellen Ausstellung Johann Peter Hebel. Das Nachleben der Worte: Manuskripte, Drucke, Bilder, Briefe und weitere Zeugnisse."
>
  <Breadcrumbs items={[{ label: "Startseite", href: "/" }, { label: "Objektübersicht" }]} />

  <main class="objects-page">
    <header class="objects-hero">
      <div>
        <h1>Objektübersicht</h1>
      </div>
    </header>

    <section class="objects-content" aria-label="Objekttabelle">
      <div class="table-toolbar">
        <p class="object-count" data-object-count>{objects.length} Objekte</p>
        <label class="quick-filter">
          <span class="sr-only">Schnellsuche</span>
          <input type="search" placeholder="Schnellsuche" autocomplete="off" data-quick-filter />
        </label>
        <label class="page-filter">
          <span class="sr-only">Nach Seite filtern</span>
          <select data-page-filter>
            <option value="">Alle Seiten</option>
            {sectionFilterGroups.map((group) => (
              <optgroup label={group.label}>
                {group.options.map((option) => <option value={option.value}>{option.label}</option>)}
              </optgroup>
            ))}
            {standalonePageOptions.length > 0 && (
              <optgroup label="Weitere Seiten">
                {standalonePageOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </optgroup>
            )}
          </select>
        </label>
        <details class="column-picker">
          <summary>Spalten</summary>
          <div class="column-picker__panel">
            <fieldset>
              <legend>Spalten anzeigen</legend>
              {columnOptions.map(([key, label]) => (
                <label>
                  <input
                    type="checkbox"
                    value={key}
                    data-column-toggle
                    checked={!defaultHiddenColumns.has(key)}
                  />
                  <span>{label}</span>
                </label>
              ))}
            </fieldset>
            <button type="button" data-columns-default>Standardansicht</button>
          </div>
        </details>
      </div>

      <div class="table-wrapper">
        <table data-object-table>
          <thead>
            <tr>
              <th scope="col" data-column="thumbnail">Bild</th>
              <th scope="col" data-column="object">Objekt</th>
              <th scope="col" data-column="usages">Verlinkung / Beschriftung</th>
              <th scope="col" data-column="metadata">Objektdaten</th>
              {dataColumns.map(([key, label]) => (
                <th scope="col" data-column={key} hidden={defaultHiddenColumns.has(key)}>{label}</th>
              ))}
            </tr>
          </thead>
          <tbody data-object-table-body>
            {objects.map((object) => (
              <tr data-object-href={object.href} data-page-filters={pageFilterKeysByObject.get(object.href)}>
                <td class="thumbnail-cell" data-column="thumbnail">
                  {object.thumbnails.length > 0 ? (
                    <div class="thumbnail-group" data-image-count={object.thumbnails.length}>
                      <div class="thumbnail-grid">
                        {object.thumbnails.map((thumbnail, index) => (
                          <a
                            href={object.href}
                            aria-label={`${object.titel} öffnen, Bild ${index + 1} von ${object.thumbnails.length}`}
                          >
                            <img
                              src={thumbnail.src}
                              width={thumbnail.width}
                              height={thumbnail.height}
                              alt=""
                              loading="lazy"
                              decoding="async"
                            />
                          </a>
                        ))}
                      </div>
                    </div>
                  ) : "-"}
                </td>
                <td class="object-cell" data-column="object">
                  <span class="object-slug">{object.slug}</span>
                  <a href={object.href}>{object.titel}</a>
                </td>
                <td class="usage-cell" data-column="usages">
                  {object.usages.length > 0 ? (
                    <ul class="cell-list usage-list">
                      {object.usages.map((usage) => (
                        <li>
                          <a class="usage-card" href={usage.href}>
                            <span class="usage-location">
                              {usage.sectionNumber && <span class="usage-number">{usage.sectionNumber}</span>}
                              <span>{usage.page}{usage.context ? `, ${usage.context}` : ""}{usage.slide ? `, Folie ${usage.slide}` : ""}{usage.image ? `, Bild ${usage.image}` : ""}</span>
                            </span>
                            {usage.captions.length > 0 && (
                              <span class="usage-captions">
                                {usage.captions.map((caption) => (
                                  <span><strong>{caption.label}:</strong> {caption.text}</span>
                                ))}
                              </span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : "-"}
                </td>
                <td class="metadata-cell" data-column="metadata">
                  {object.metadata.length > 0 ? (
                    <dl class="metadata-list">
                      {object.metadata.map((detail) => (
                        <div class:list={["metadata-item", { "metadata-item--wide": detail.wide }]}>
                          <dt>{detail.label}</dt>
                          <dd set:html={detail.html}></dd>
                        </div>
                      ))}
                    </dl>
                  ) : "-"}
                </td>
                <td class="technical-cell" data-column="imageData" hidden>
                  {object.imageData.length > 0 ? (
                    <ol class="image-data-list">
                      {object.imageData.map((image) => (
                        <li>
                          <strong>{image.label}</strong>
                          <dl class="technical-data-list">
                            {image.details.map((detail) => (
                              <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>
                            ))}
                          </dl>
                        </li>
                      ))}
                    </ol>
                  ) : "-"}
                </td>
                <td class="technical-cell" data-column="systemData" hidden>
                  <dl class="technical-data-list">
                    {object.systemData.map((detail) => (
                      <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>
                    ))}
                  </dl>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>

<script>
  const defaultHiddenColumnKeys = [
    "imageData",
    "systemData",
  ];
  const storageKey = "objects-table-hidden-columns-v5";
  const table = document.querySelector<HTMLTableElement>("[data-object-table]");
  const toggles = Array.from(document.querySelectorAll<HTMLInputElement>("[data-column-toggle]"));
  let hiddenColumns = new Set(defaultHiddenColumnKeys);

  try {
    const storedColumns = JSON.parse(localStorage.getItem(storageKey) ?? "null");
    if (Array.isArray(storedColumns)) hiddenColumns = new Set(storedColumns);
  } catch {
    localStorage.removeItem(storageKey);
  }

  const applyColumnVisibility = () => {
    for (const toggle of toggles) {
      const hidden = hiddenColumns.has(toggle.value);
      toggle.checked = !hidden;
      table?.querySelectorAll<HTMLElement>(`[data-column="${toggle.value}"]`).forEach((cell) => {
        cell.hidden = hidden;
      });
    }
  };

  applyColumnVisibility();

  for (const toggle of toggles) {
    toggle.addEventListener("change", () => {
      if (toggle.checked) hiddenColumns.delete(toggle.value);
      else hiddenColumns.add(toggle.value);
      localStorage.setItem(storageKey, JSON.stringify([...hiddenColumns]));
      applyColumnVisibility();
    });
  }

  document.querySelector("[data-columns-default]")?.addEventListener("click", () => {
    hiddenColumns = new Set(defaultHiddenColumnKeys);
    localStorage.removeItem(storageKey);
    applyColumnVisibility();
  });

  document.querySelector("[data-object-table-body]")?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || event.target.closest("a, button, input, label")) return;
    const selection = window.getSelection();
    if (selection && !selection.isCollapsed) return;

    const row = event.target.closest<HTMLTableRowElement>("[data-object-href]");
    if (row?.dataset.objectHref) window.location.assign(row.dataset.objectHref);
  });

  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("[data-object-href]"));
  const filter = document.querySelector<HTMLInputElement>("[data-quick-filter]");
  const pageFilter = document.querySelector<HTMLSelectElement>("[data-page-filter]");
  const count = document.querySelector<HTMLElement>("[data-object-count]");

  const applyFilters = () => {
    const query = filter?.value.trim().toLocaleLowerCase("de") ?? "";
    const selectedPage = pageFilter?.value ?? "";
    let visibleRows = 0;

    for (const row of rows) {
      const matchesQuery = !query || (row.textContent ?? "").toLocaleLowerCase("de").includes(query);
      const matchesPage = !selectedPage || (row.dataset.pageFilters ?? "").split(" ").includes(selectedPage);
      const visible = matchesQuery && matchesPage;
      row.hidden = !visible;
      if (visible) visibleRows += 1;
    }

    if (count) count.textContent = visibleRows === rows.length ? `${rows.length} Objekte` : `${visibleRows} / ${rows.length}`;
  };

  filter?.addEventListener("input", applyFilters);
  pageFilter?.addEventListener("change", applyFilters);
</script>

<style>
  @reference "../../styles/global.css";

  .objects-page {
    background: var(--color-paper);
    color: var(--color-text-primary);
  }

  .objects-hero {
    display: flex;
    padding: var(--spacing-40) var(--spacing-20);
  }

  .objects-hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    line-height: var(--text-h1--line-height);
  }

  .quick-filter {
    display: flex;
    min-width: min(30rem, 55vw);
    align-items: center;
    gap: var(--spacing-8);
    font-size: var(--text-small);
  }

  .quick-filter span {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .quick-filter input {
    flex: 1;
    min-width: 12rem;
    min-height: 2.75rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-ash-grey);
    border-radius: 0;
    color: var(--color-text-primary);
    background: var(--color-paper);
    font: inherit;
    font-size: var(--text-caption);
  }

  .quick-filter input:focus {
    border-color: var(--color-ink);
    outline: 1px solid var(--color-ink);
    outline-offset: 2px;
  }

  .objects-content {
    padding: 0 var(--spacing-20) var(--spacing-64);
  }

  .table-toolbar {
    display: flex;
    margin-bottom: var(--spacing-24);
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: var(--spacing-20);
  }

  .object-count {
    margin: 0;
    margin-right: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    white-space: nowrap;
  }

  .column-picker {
    position: relative;
    z-index: 4;
  }

  .column-picker summary,
  .column-picker button,
  .page-filter select {
    min-height: 2.5rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-ash-grey);
    border-radius: 0;
    color: var(--color-text-primary);
    background: var(--color-paper);
    font: inherit;
    font-size: var(--text-caption);
    font-weight: 600;
    cursor: pointer;
  }

  .page-filter {
    position: relative;
    display: flex;
  }

  .page-filter::after {
    position: absolute;
    top: 50%;
    right: 1rem;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    content: "";
    pointer-events: none;
    transform: translateY(-70%) rotate(45deg);
  }

  .page-filter select {
    min-width: 13rem;
    padding-right: 2.5rem;
    appearance: none;
  }

  .column-picker summary {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    list-style: none;
  }

  .column-picker summary::-webkit-details-marker {
    display: none;
  }

  .column-picker summary::after {
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    content: "";
    transform: rotate(45deg) translateY(-0.15rem);
  }

  .column-picker[open] summary::after {
    transform: rotate(225deg) translate(-0.1rem, -0.1rem);
  }

  .column-picker__panel {
    position: absolute;
    right: 0;
    width: min(22rem, calc(100vw - 2 * var(--spacing-20)));
    max-height: min(34rem, 70vh);
    padding: var(--spacing-16);
    margin-top: var(--spacing-8);
    overflow-y: auto;
    border: 1px solid var(--color-ash-grey);
    border-radius: 0;
    box-shadow: 0 0.8rem 2rem rgb(38 37 30 / 16%);
    background: var(--color-paper);
  }

  .column-picker fieldset {
    display: grid;
    padding: 0;
    margin: 0 0 var(--spacing-16);
    border: 0;
    gap: var(--spacing-4);
  }

  .column-picker legend {
    padding: 0;
    margin-bottom: var(--spacing-8);
    font-size: var(--text-caption);
    font-weight: 600;
  }

  .column-picker label {
    display: flex;
    min-height: 2rem;
    align-items: center;
    gap: var(--spacing-8);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .column-picker input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--color-link);
  }

  .column-picker button {
    width: 100%;
    background: var(--color-oat);
  }

  .table-wrapper {
    width: 100%;
    max-height: calc(100vh - 10rem);
    overflow: auto;
    border: 1px solid var(--color-ink);
    border-radius: 0;
    box-shadow: 0 0.4rem 1.5rem rgb(38 37 30 / 7%);
  }

  table {
    width: max-content;
    min-width: 100%;
    border-collapse: collapse;
    background: var(--color-paper);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  table :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  th,
  td {
    min-width: 150px;
    max-width: 360px;
    padding: var(--spacing-12) var(--spacing-16);
    border-bottom: 1px solid var(--color-ink);
    text-align: left;
    vertical-align: top;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  th {
    position: sticky;
    top: 0;
    z-index: 2;
    border-bottom: 0;
    box-shadow: inset 0 -1px var(--color-ink);
    background: var(--color-oat);
    font-weight: 600;
    letter-spacing: 0.015em;
    white-space: nowrap;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  tbody tr:nth-child(even) td {
    background: rgb(38 37 30 / 3%);
  }

  tbody tr {
    cursor: pointer;
  }

  tbody tr:hover td {
    background: #f2eee2;
  }

  tbody tr:focus-within td {
    background: #f2eee2;
  }

  [data-column="thumbnail"] {
    min-width: 112px;
    width: 112px;
    max-width: 112px;
  }

  .thumbnail-group {
    display: grid;
  }

  .thumbnail-grid {
    display: grid;
    grid-template-columns: 80px;
    gap: var(--spacing-12);
  }

  .thumbnail-grid a {
    display: block;
    width: 80px;
    height: 68px;
    border: 1px solid var(--color-ash-grey);
    border-radius: 0;
    overflow: hidden;
    background: var(--color-oat);
  }

  .thumbnail-grid img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .object-cell {
    min-width: 240px;
    max-width: 320px;
    font-size: 0.86rem;
    font-weight: 600;
    white-space: normal;
  }

  .object-slug {
    display: block;
    margin-bottom: var(--spacing-6, 6px);
    color: var(--color-text-secondary);
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .object-cell a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .object-cell a:hover {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .metadata-cell {
    min-width: 420px;
    max-width: 500px;
    white-space: normal;
  }

  .metadata-list {
    display: grid;
    margin: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-8);
  }

  .metadata-item {
    display: grid;
    align-content: start;
    padding: var(--spacing-12);
    border: 1px solid var(--color-ash-grey);
    border-radius: 0;
    background: rgb(255 255 255 / 48%);
    gap: var(--spacing-6, 6px);
  }

  .metadata-item--wide {
    grid-column: 1 / -1;
  }

  .metadata-list dt {
    color: var(--color-ink);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .metadata-list dd {
    margin: 0;
    color: var(--color-text-primary);
    line-height: 1.55;
    white-space: pre-line;
  }

  .technical-cell {
    min-width: 340px;
    max-width: 460px;
    white-space: normal;
  }

  .technical-data-list {
    display: grid;
    margin: 0;
    gap: var(--spacing-8);
  }

  .technical-data-list div {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--spacing-12);
  }

  .technical-data-list dt {
    color: var(--color-text-secondary);
    font-size: 0.68rem;
    font-weight: 600;
  }

  .technical-data-list dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .image-data-list {
    display: grid;
    padding: 0;
    margin: 0;
    gap: var(--spacing-12);
    list-style: none;
  }

  .image-data-list > li {
    display: grid;
    padding: var(--spacing-12);
    border: 1px solid var(--color-ash-grey);
    border-radius: 0;
    background: rgb(255 255 255 / 48%);
    gap: var(--spacing-8);
  }

  .image-data-list > li > strong {
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .usage-cell {
    min-width: 280px;
    max-width: 360px;
    white-space: normal;
  }

  .cell-list {
    display: grid;
    padding: 0;
    margin: 0;
    gap: var(--spacing-12);
    list-style: none;
  }

  .cell-list li {
    display: grid;
    gap: var(--spacing-4);
  }

  .cell-list li + li {
    padding-top: var(--spacing-12);
    border-top: 1px solid var(--color-ash-grey);
  }

  .cell-list a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .usage-list {
    gap: var(--spacing-8);
  }

  .usage-list li + li {
    padding-top: 0;
    border-top: 0;
  }

  .cell-list .usage-card {
    display: grid;
    padding: var(--spacing-12);
    border: 1px solid var(--color-ash-grey);
    border-radius: 0;
    color: var(--color-text-primary);
    background: rgb(255 255 255 / 42%);
    gap: var(--spacing-10, 10px);
    text-decoration: none;
    transition: border-color 150ms var(--ease-default), background-color 150ms var(--ease-default);
  }

  .cell-list .usage-card:hover {
    border-color: var(--color-ink);
    background: var(--color-oat);
  }

  .usage-location {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-8);
    font-weight: 600;
    line-height: 1.5;
  }

  .usage-number {
    display: inline-flex;
    flex: none;
    min-width: 2rem;
    justify-content: center;
    padding: 0.15rem 0.4rem;
    border-radius: 0;
    color: var(--color-paper);
    background: var(--color-ink);
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .usage-captions {
    display: grid;
    padding-top: var(--spacing-8);
    border-top: 1px solid var(--color-ash-grey);
    color: var(--color-text-secondary);
    gap: var(--spacing-4);
  }

  @media (min-width: 768px) {
    .objects-hero {
      padding-inline: var(--spacing-32);
    }

    .objects-content {
      padding-inline: var(--spacing-32);
    }
  }

  @media (max-width: 767px) {
    .quick-filter {
      width: 100%;
      min-width: 0;
      align-items: stretch;
      flex-direction: column;
    }

    .table-toolbar {
      align-items: flex-end;
    }

    .page-filter {
      flex: 1;
    }

    .page-filter select {
      width: 100%;
      min-width: 0;
    }

    .table-wrapper {
      max-height: calc(100vh - 8rem);
    }

    .metadata-cell {
      min-width: 320px;
    }

    .metadata-list {
      grid-template-columns: 1fr;
    }

    .metadata-item--wide {
      grid-column: auto;
