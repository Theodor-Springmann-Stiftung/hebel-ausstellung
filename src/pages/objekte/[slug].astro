---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import ObjectDetail from '../../components/object/ObjectDetail.astro';
import { getObjectRoutes } from '../../lib/content';

export const getStaticPaths = getObjectRoutes;

const { object, context } = Astro.props;
const breadcrumbItems = [
	{ label: 'Startseite', href: '/' },
	{ label: 'Objekte', href: '/objekte/' },
	{ label: object.data.titel ?? 'Objekt' },
];
---

<Layout>
	<div class="object-breadcrumbs"><Breadcrumbs items={breadcrumbItems} /></div>
	<ObjectDetail
		object={object}
		images={context.images}
		returnContexts={context.returnContexts}
	/>
</Layout>

<style>
	.object-breadcrumbs {
		display: none;
	}

	@media (min-width: 768px) {
		.object-breadcrumbs {
			display: block;
		}
	}
</style>
