---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Breadcrumbs from "../components/navigation/Breadcrumbs.astro";
import Layout from "../layouts/Layout.astro";
import { getObjectRightsBySlug, type ObjectRights } from "../lib/image-rights";
import { markdownBodyToPlainText, markdownToPlainText, renderInlineMarkdown } from "../lib/markdown";
import { findContentImage, findObjectImage } from "../lib/object-images";
import { getObjectUsagesById } from "../lib/object-usages";

const preserveMarkdownUrls = (value = "") =>
  value.replace(/\[([^\]]+)]\(([^)]+)\)/g, "$1 ($2)");

const plainInline = (value?: string) =>
  value ? markdownToPlainText(preserveMarkdownUrls(value)).replace(/\s+/g, " ").trim() : "";

const plainBody = (value?: string) =>
  value ? markdownBodyToPlainText(preserveMarkdownUrls(value)) : "";

const usageOrder = (usage: { type: string; sectionNumber?: string }) => {
  if (usage.type === "Startseite") return [0];
  if (usage.type === "Über") return [1];
  if (usage.sectionNumber) return [2, ...usage.sectionNumber.split(".").map(Number)];
  return [3];
};

const compareOrder = (left: number[], right: number[]) => {
  for (let index = 0; index < Math.max(left.length, right.length); index += 1) {
    const difference = (left[index] ?? -1) - (right[index] ?? -1);
    if (difference !== 0) return difference;
  }
  return 0;
};

const [objectEntries, rightsBySlug, usagesByObjectId] = await Promise.all([
  getCollection("objects"),
  getObjectRightsBySlug(),
  getObjectUsagesById(),
]);
const emptyRights: ObjectRights = { status: "Nicht erfasst", items: [] };

const objects = (await Promise.all(objectEntries.map(async (object) => {
  const associations = object.data.bilder ?? [];
  const displayImages = [];
  const seenImageSources = new Set<string>();

  for (const association of associations.filter((association) => association.inObjektansicht)) {
    const image = await findContentImage(association.bild);
    if (!image || seenImageSources.has(image.asset.src)) continue;
    seenImageSources.add(image.asset.src);
    displayImages.push(image.asset);
  }

  const fallbackImage = findObjectImage(object.id);
  if (displayImages.length === 0 && fallbackImage) displayImages.push(fallbackImage);

  const thumbnails = await Promise.all(displayImages.map((asset) => (
    getImage({ src: asset, width: Math.min(120, asset.width), format: "webp", quality: 70 })
  )));
  const usages = (usagesByObjectId.get(object.id) ?? []).map((usage) => {
    const page = plainInline(usage.page);
    const section = page.match(/^(?:Unterkapitel|Kapitel)\s+([^:]+):\s*(.+)$/);

    return {
      ...usage,
      page: section?.[2] ?? page,
      sectionNumber: section?.[1],
      context: plainInline(usage.context),
      captions: usage.captions.map((caption) => ({ ...caption, text: plainInline(caption.text) })),
    };
  }).sort((left, right) => compareOrder(usageOrder(left), usageOrder(right)));

  return {
    slug: object.data.slug,
    href: `/objekte/${object.data.slug}/`,
    thumbnails,
    rights: rightsBySlug.get(object.data.slug) ?? emptyRights,
    usages,
    titel: plainInline(object.data.titel),
    metadata: [
      { label: "Urheber", value: object.data.urheber },
      { label: "Datum", value: object.data.datierung },
      { label: "Material und Technik", value: object.data.materialTechnik },
      { label: "Institution", value: object.data.institution },
      { label: "Inventarnummer", value: object.data.inventarnummer },
      { label: "Quelle", value: object.data.quelle, wide: true },
      { label: "Inhalt", value: plainBody(object.body), wide: true },
    ].filter(({ value }) => Boolean(value)).map(({ label, value, wide }) => ({
      label,
      html: renderInlineMarkdown(value),
      wide,
    })),
    imageData: associations.map((association, index) => ({
      label: `Bild ${index + 1}`,
      details: [
        { label: "Datei", value: association.bild },
        { label: "Position", value: association.position ?? "-" },
        { label: "Objektreihenfolge", value: String(association.objektReihenfolge ?? "-") },
        { label: "Beschriftung", value: plainInline(association.beschriftung) || "-" },
        { label: "In Objektansicht", value: association.inObjektansicht ? "Ja" : "Nein" },
      ],
    })),
    systemData: [
      { label: "ID", value: object.id },
      { label: "Kapitelunabhängig", value: object.data.kapitelunabhaengig ? "Ja" : "Nein" },
      { label: "Transkription", value: object.data.transkription ? "Ja" : "Nein" },
      { label: "Transkriptionsart", value: object.data.transkriptionsart },
      { label: "Untertitel", value: plainInline(object.data.untertitel) || "-" },
    ],
  };
}))).sort((left, right) => (
  compareOrder(usageOrder(left.usages[0] ?? { type: "Nicht verwendet" }), usageOrder(right.usages[0] ?? { type: "Nicht verwendet" }))
  || left.titel.localeCompare(right.titel, "de")
));

const dataColumns = [
  ["imageData", "Bilddaten"],
  ["systemData", "Systemdaten"],
] as const;

const columnOptions = [
  ["thumbnail", "Bild"],
  ["object", "Objekt"],
  ["rights", "Lizenz / Genehmigung"],
  ["usages", "Verlinkung / Beschriftung"],
  ["metadata", "Objektdaten"],
  ...dataColumns,
] as const;
const defaultHiddenColumns = new Set([
  "imageData",
  "systemData",
]);
---

<Layout title="Objektübersicht">
  <Breadcrumbs items={[{ label: "Startseite", href: "/" }, { label: "Objektübersicht" }]} />

  <main class="objects-page">
    <header class="objects-hero">
      <div>
        <h1>Objektübersicht</h1>
        <p data-object-count>{objects.length} Objekte</p>
      </div>
    </header>

    <section class="objects-content" aria-label="Objekttabelle">
      <div class="table-toolbar">
        <label class="quick-filter">
          <span>Schnellsuche</span>
          <input type="search" placeholder="Titel, Institution, Quelle …" autocomplete="off" data-quick-filter />
        </label>
        <details class="column-picker">
          <summary>Spalten</summary>
          <div class="column-picker__panel">
            <fieldset>
              <legend>Spalten anzeigen</legend>
              {columnOptions.map(([key, label]) => (
                <label>
                  <input
                    type="checkbox"
                    value={key}
                    data-column-toggle
                    checked={!defaultHiddenColumns.has(key)}
                  />
                  <span>{label}</span>
                </label>
              ))}
            </fieldset>
            <button type="button" data-columns-default>Standardansicht</button>
          </div>
        </details>
      </div>

      <div class="table-wrapper">
        <table data-object-table>
          <thead>
            <tr>
              <th scope="col" data-column="thumbnail">Bild</th>
              <th scope="col" data-column="object">Objekt</th>
              <th scope="col" data-column="rights">Lizenz / Genehmigung</th>
              <th scope="col" data-column="usages">Verlinkung / Beschriftung</th>
              <th scope="col" data-column="metadata">Objektdaten</th>
              {dataColumns.map(([key, label]) => (
                <th scope="col" data-column={key} hidden={defaultHiddenColumns.has(key)}>{label}</th>
              ))}
            </tr>
          </thead>
          <tbody data-object-table-body>
            {objects.map((object) => (
              <tr data-object-href={object.href}>
                <td class="thumbnail-cell" data-column="thumbnail">
                  {object.thumbnails.length > 0 ? (
                    <div class="thumbnail-group" data-image-count={object.thumbnails.length}>
                      <div class="thumbnail-grid">
                        {object.thumbnails.map((thumbnail, index) => (
                          <a
                            href={object.href}
                            aria-label={`${object.titel} öffnen, Bild ${index + 1} von ${object.thumbnails.length}`}
                          >
                            <img
                              src={thumbnail.src}
                              width={thumbnail.attributes.width}
                              height={thumbnail.attributes.height}
                              alt=""
                              loading="lazy"
                              decoding="async"
                            />
                          </a>
                        ))}
                      </div>
                    </div>
                  ) : "-"}
                </td>
                <td class="object-cell" data-column="object">
                  <span class="object-slug">{object.slug}</span>
                  <a href={object.href}>{object.titel}</a>
                </td>
                <td class="rights-cell" data-column="rights">
                  <span class:list={[
                    "status",
                    `status--${object.rights.status === "Geklärt" ? "cleared" : object.rights.status === "Offen" ? "open" : "missing"}`,
                  ]}>
                    {object.rights.status}
                  </span>
                  {object.rights.items.length > 0 ? (
                    <ul class="cell-list">
                      {object.rights.items.map((item) => (
                        <li>
                          {item.editing.length > 0 && <span class="rights-edit">Bearbeitung: {item.editing.join(", ")}</span>}
                          {item.href
                            ? <a href={item.href} target="_blank" rel="noreferrer">{item.text}</a>
                            : <span>{item.text}</span>}
                        </li>
                      ))}
                    </ul>
                  ) : "-"}
                </td>
                <td class="usage-cell" data-column="usages">
                  {object.usages.length > 0 ? (
                    <ul class="cell-list usage-list">
                      {object.usages.map((usage) => (
                        <li>
                          <a class="usage-card" href={usage.href}>
                            <span class="usage-location">
                              {usage.sectionNumber && <span class="usage-number">{usage.sectionNumber}</span>}
                              <span>{usage.page}{usage.context ? `, ${usage.context}` : ""}{usage.slide ? `, Folie ${usage.slide}` : ""}{usage.image ? `, Bild ${usage.image}` : ""}</span>
                            </span>
                            {usage.captions.length > 0 && (
                              <span class="usage-captions">
                                {usage.captions.map((caption) => (
                                  <span><strong>{caption.label}:</strong> {caption.text}</span>
                                ))}
                              </span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : "-"}
                </td>
                <td class="metadata-cell" data-column="metadata">
                  {object.metadata.length > 0 ? (
                    <dl class="metadata-list">
                      {object.metadata.map((detail) => (
                        <div class:list={["metadata-item", { "metadata-item--wide": detail.wide }]}>
                          <dt>{detail.label}</dt>
                          <dd set:html={detail.html}></dd>
                        </div>
                      ))}
                    </dl>
                  ) : "-"}
                </td>
                <td class="technical-cell" data-column="imageData" hidden>
                  {object.imageData.length > 0 ? (
                    <ol class="image-data-list">
                      {object.imageData.map((image) => (
                        <li>
                          <strong>{image.label}</strong>
                          <dl class="technical-data-list">
                            {image.details.map((detail) => (
                              <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>
                            ))}
                          </dl>
                        </li>
                      ))}
                    </ol>
                  ) : "-"}
                </td>
                <td class="technical-cell" data-column="systemData" hidden>
                  <dl class="technical-data-list">
                    {object.systemData.map((detail) => (
                      <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>
                    ))}
                  </dl>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>

<script>
  const defaultHiddenColumnKeys = [
    "imageData",
    "systemData",
  ];
  const storageKey = "objects-table-hidden-columns-v4";
  const table = document.querySelector<HTMLTableElement>("[data-object-table]");
  const toggles = Array.from(document.querySelectorAll<HTMLInputElement>("[data-column-toggle]"));
  let hiddenColumns = new Set(defaultHiddenColumnKeys);

  try {
    const storedColumns = JSON.parse(localStorage.getItem(storageKey) ?? "null");
    if (Array.isArray(storedColumns)) hiddenColumns = new Set(storedColumns);
  } catch {
    localStorage.removeItem(storageKey);
  }

  const applyColumnVisibility = () => {
    for (const toggle of toggles) {
      const hidden = hiddenColumns.has(toggle.value);
      toggle.checked = !hidden;
      table?.querySelectorAll<HTMLElement>(`[data-column="${toggle.value}"]`).forEach((cell) => {
        cell.hidden = hidden;
      });
    }
  };

  applyColumnVisibility();

  for (const toggle of toggles) {
    toggle.addEventListener("change", () => {
      if (toggle.checked) hiddenColumns.delete(toggle.value);
      else hiddenColumns.add(toggle.value);
      localStorage.setItem(storageKey, JSON.stringify([...hiddenColumns]));
      applyColumnVisibility();
    });
  }

  document.querySelector("[data-columns-default]")?.addEventListener("click", () => {
    hiddenColumns = new Set(defaultHiddenColumnKeys);
    localStorage.removeItem(storageKey);
    applyColumnVisibility();
  });

  document.querySelector("[data-object-table-body]")?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || event.target.closest("a, button, input, label")) return;
    const selection = window.getSelection();
    if (selection && !selection.isCollapsed) return;

    const row = event.target.closest<HTMLTableRowElement>("[data-object-href]");
    if (row?.dataset.objectHref) window.location.assign(row.dataset.objectHref);
  });

  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("[data-object-href]"));
  const filter = document.querySelector<HTMLInputElement>("[data-quick-filter]");
  const count = document.querySelector<HTMLElement>("[data-object-count]");

  filter?.addEventListener("input", () => {
    const query = filter.value.trim().toLocaleLowerCase("de");
    let visibleRows = 0;

    for (const row of rows) {
      const visible = !query || (row.textContent ?? "").toLocaleLowerCase("de").includes(query);
      row.hidden = !visible;
      if (visible) visibleRows += 1;
    }

    if (count) count.textContent = query ? `${visibleRows} von ${rows.length} Objekten` : `${rows.length} Objekte`;
  });
</script>

<style>
  @reference "../styles/global.css";

  .objects-page {
    background: var(--color-paper);
    color: var(--color-text-primary);
  }

  .objects-hero {
    display: flex;
    padding: var(--spacing-40) var(--spacing-20);
  }

  .objects-hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    line-height: var(--text-h1--line-height);
  }

  .objects-hero p {
    margin: var(--spacing-8) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
  }

  .quick-filter {
    display: flex;
    min-width: min(30rem, 55vw);
    align-items: center;
    gap: var(--spacing-8);
    font-size: var(--text-small);
  }

  .quick-filter span {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .quick-filter input {
    flex: 1;
    min-width: 12rem;
    min-height: 2.75rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-ash-grey);
    border-radius: 2px;
    color: var(--color-text-primary);
    background: var(--color-paper);
    font: inherit;
  }

  .quick-filter input:focus {
    border-color: var(--color-ink);
    outline: 1px solid var(--color-ink);
    outline-offset: 2px;
  }

  .objects-content {
    padding: 0 var(--spacing-20) var(--spacing-64);
  }

  .table-toolbar {
    display: flex;
    margin-bottom: var(--spacing-24);
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-20);
  }

  .table-toolbar p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    white-space: nowrap;
  }

  .column-picker {
    position: relative;
    z-index: 4;
  }

  .column-picker summary,
  .column-picker button {
    min-height: 2.5rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-ash-grey);
    border-radius: 0.25rem;
    color: var(--color-text-primary);
    background: var(--color-paper);
    font: inherit;
    font-size: var(--text-caption);
    font-weight: 600;
    cursor: pointer;
  }

  .column-picker summary {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    list-style: none;
  }

  .column-picker summary::-webkit-details-marker {
    display: none;
  }

  .column-picker summary::after {
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    content: "";
    transform: rotate(45deg) translateY(-0.15rem);
  }

  .column-picker[open] summary::after {
    transform: rotate(225deg) translate(-0.1rem, -0.1rem);
  }

  .column-picker__panel {
    position: absolute;
    right: 0;
    width: min(22rem, calc(100vw - 2 * var(--spacing-20)));
    max-height: min(34rem, 70vh);
    padding: var(--spacing-16);
    margin-top: var(--spacing-8);
    overflow-y: auto;
    border: 1px solid var(--color-ash-grey);
    border-radius: 0.25rem;
    box-shadow: 0 0.8rem 2rem rgb(38 37 30 / 16%);
    background: var(--color-paper);
  }

  .column-picker fieldset {
    display: grid;
    padding: 0;
    margin: 0 0 var(--spacing-16);
    border: 0;
    gap: var(--spacing-4);
  }

  .column-picker legend {
    padding: 0;
    margin-bottom: var(--spacing-8);
    font-size: var(--text-caption);
    font-weight: 600;
  }

  .column-picker label {
    display: flex;
    min-height: 2rem;
    align-items: center;
    gap: var(--spacing-8);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .column-picker input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--color-link);
  }

  .column-picker button {
    width: 100%;
    background: var(--color-oat);
  }

  .table-wrapper {
    width: 100%;
    max-height: calc(100vh - 10rem);
    overflow: auto;
    border: 1px solid var(--color-ash-grey);
    border-radius: 0.35rem;
    box-shadow: 0 0.4rem 1.5rem rgb(38 37 30 / 7%);
  }

  table {
    width: max-content;
    min-width: 100%;
    border-collapse: collapse;
    background: var(--color-paper);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  table :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  th,
  td {
    min-width: 150px;
    max-width: 360px;
    padding: var(--spacing-12) var(--spacing-16);
    border-right: 1px solid var(--color-ash-grey);
    border-bottom: 1px solid var(--color-ash-grey);
    text-align: left;
    vertical-align: top;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--color-oat);
    font-weight: 600;
    letter-spacing: 0.015em;
    white-space: nowrap;
  }

  th:last-child,
  td:last-child {
    border-right: 0;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  tbody tr:nth-child(even) td {
    background: rgb(38 37 30 / 3%);
  }

  tbody tr {
    cursor: pointer;
  }

  tbody tr:hover td {
    background: #f2eee2;
  }

  tbody tr:focus-within td {
    background: #f2eee2;
  }

  .thumbnail-cell {
    min-width: 188px;
    width: 188px;
    max-width: 188px;
  }

  .thumbnail-group {
    display: grid;
  }

  .thumbnail-grid {
    display: grid;
    grid-template-columns: repeat(2, 72px);
    gap: var(--spacing-12);
  }

  .thumbnail-grid a {
    display: block;
    width: 72px;
    height: 64px;
    border: 1px solid var(--color-ash-grey);
    border-radius: 0.2rem;
    overflow: hidden;
    background: var(--color-oat);
  }

  .thumbnail-grid img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .object-cell {
    min-width: 240px;
    max-width: 320px;
    font-size: 0.86rem;
    font-weight: 600;
    white-space: normal;
  }

  .object-slug {
    display: block;
    margin-bottom: var(--spacing-6, 6px);
    color: var(--color-text-secondary);
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .object-cell a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .object-cell a:hover {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .status {
    display: inline-flex;
    padding: 0.3rem 0.55rem;
    border: 1px solid currentColor;
    border-radius: 2px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .status--cleared {
    color: #315f46;
    background: #e4efe6;
  }

  .status--open {
    color: #8b381f;
    background: #f7e5dc;
  }

  .status--missing {
    color: var(--color-text-secondary);
    background: var(--color-oat);
  }

  .rights-cell {
    min-width: 300px;
    max-width: 390px;
    white-space: normal;
  }

  .metadata-cell {
    min-width: 460px;
    max-width: 560px;
    white-space: normal;
  }

  .metadata-list {
    display: grid;
    margin: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-8);
  }

  .metadata-item {
    display: grid;
    align-content: start;
    padding: var(--spacing-12);
    border: 1px solid var(--color-ash-grey);
    border-radius: 2px;
    background: rgb(255 255 255 / 48%);
    gap: var(--spacing-6, 6px);
  }

  .metadata-item--wide {
    grid-column: 1 / -1;
  }

  .metadata-list dt {
    color: var(--color-ink);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .metadata-list dd {
    margin: 0;
    color: var(--color-text-primary);
    line-height: 1.55;
    white-space: pre-line;
  }

  .technical-cell {
    min-width: 340px;
    max-width: 460px;
    white-space: normal;
  }

  .technical-data-list {
    display: grid;
    margin: 0;
    gap: var(--spacing-8);
  }

  .technical-data-list div {
    display: grid;
    grid-template-columns: minmax(7.5rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--spacing-12);
  }

  .technical-data-list dt {
    color: var(--color-text-secondary);
    font-size: 0.68rem;
    font-weight: 600;
  }

  .technical-data-list dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .image-data-list {
    display: grid;
    padding: 0;
    margin: 0;
    gap: var(--spacing-12);
    list-style: none;
  }

  .image-data-list > li {
