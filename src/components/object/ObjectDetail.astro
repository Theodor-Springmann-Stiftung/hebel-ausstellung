---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { renderInlineMarkdown, serializeForScript } from "../../lib/markdown";
import type { ObjectDisplayImage } from "../../lib/object-images";
import ObjectImages from "./ObjectImages.astro";

type Props = {
  object: CollectionEntry<"objects">;
  images: ObjectDisplayImage[];
};

const { object, images } = Astro.props as Props;
const { Content } = await render(object);
const hasBody = Boolean(object.body?.trim());
const hasMultipleImages = images.length > 1;
const titleHtml = renderInlineMarkdown(object.data.titel).replace(/([A-Z]\.)\[/g, "$1&#8288;[");
const initialReturnContext = images[0]?.returnContext;
const returnHref = initialReturnContext?.href ?? "/";
const returnLabel = initialReturnContext?.label ?? "Zurück zur Startseite";
const returnData = {
  images: images.map((image) => ({ key: image.key, returnContext: image.returnContext })),
};

const details = [
  { label: "Urheber", value: object.data.urheber },
  { label: "Datum", value: object.data.datierung },
  { label: "Material und Technik", value: object.data.materialTechnik },
  { label: "Institution", value: object.data.institution },
  { label: "Inventarnummer", value: object.data.inventarnummer },
  { label: "Quelle", value: object.data.quelle },
  { label: "Lizenz", value: object.data.lizenz },
].filter((detail) => detail.value);
---

<article class="object-detail">
  <header class="object-detail__header">
    <p class="object-detail__eyebrow">Objekt</p>
    <h1>
      <span data-object-position></span><span set:html={titleHtml}></span>
    </h1>
    {object.data.untertitel && <p class="object-detail__subtitle" set:html={renderInlineMarkdown(object.data.untertitel)}></p>}
  </header>

  <ObjectImages images={images} />

  <div class="object-detail__content">
    <aside class="object-detail__sidebar" aria-label="Objektdaten">
      <dl class="object-detail__metadata">
        {details.map((detail) => (
          <div class="object-detail__metadata-item">
            <dt>{detail.label}</dt>
            <dd set:html={renderInlineMarkdown(detail.value)}></dd>
          </div>
        ))}
      </dl>

      <a class="object-detail__return-link" href={returnHref} data-object-return-link>
        <span class="object-detail__return-link-arrow" aria-hidden="true">←</span><span data-object-return-label>{returnLabel}</span>
      </a>
    </aside>

    {hasBody && <div class="object-detail__body"><Content /></div>}
  </div>
</article>

{hasMultipleImages && (
  <script type="application/json" data-object-return-contexts set:html={serializeForScript(returnData)}></script>
)}

<script>
  type ReturnContext = {
    href: string;
    label: string;
  };

  type ReturnData = {
    images: Array<{ key: string; returnContext?: ReturnContext }>;
  };

  const position = new URLSearchParams(window.location.search).get("position");

  if (position === "Links" || position === "Rechts" || position === "Vorne") {
    document.querySelectorAll<HTMLElement>("[data-object-position]").forEach((label) => {
      label.textContent = `${position}: `;
    });
  }

  const returnLink = document.querySelector<HTMLAnchorElement>("[data-object-return-link]");
  const returnLabel = returnLink?.querySelector<HTMLElement>("[data-object-return-label]");
  const returnDataElement = document.querySelector<HTMLScriptElement>("[data-object-return-contexts]");
  const returnData: ReturnData | undefined = returnDataElement?.textContent
    ? JSON.parse(returnDataElement.textContent)
    : undefined;

  const getReferrerContext = (): ReturnContext => {
    if (document.referrer) {
      const referrer = new URL(document.referrer);

      if (referrer.origin === window.location.origin && referrer.pathname !== window.location.pathname) {
        const chapterMatch = referrer.pathname.match(/^\/(\d+)(?:\/[^/]+)?\/$/);
        const label = referrer.pathname === "/ueber/"
          ? "Zurück zu Über die Ausstellung"
          : chapterMatch
            ? `Zurück zu Kapitel ${Number(chapterMatch[1])}`
            : referrer.pathname === "/"
              ? "Zurück zur Startseite"
              : undefined;

        if (label) {
          return {
            href: `${referrer.pathname}${referrer.search}`,
            label,
          };
        }
      }
    }

    return { href: "/", label: "Zurück zur Startseite" };
  };

  const getImageContext = (imageKey: string | undefined) => {
    if (!returnData || !imageKey) return undefined;
    return returnData.images.find((image) => image.key === imageKey)?.returnContext;
  };

  const setReturnContext = (context: ReturnContext) => {
    if (!returnLink || !returnLabel) return;
    returnLink.href = context.href;
    returnLabel.textContent = context.label;
  };

  if (returnData) {
    const search = new URLSearchParams(window.location.search);
    const requestedImageKey = search.get("image");
    let activeImageKey = requestedImageKey && returnData.images.some((image) => image.key === requestedImageKey)
      ? requestedImageKey
      : returnData.images[0]?.key;
    const initialContext = getImageContext(activeImageKey);
    setReturnContext(initialContext ?? getReferrerContext());

    window.addEventListener("object-carousel-change", ((event: CustomEvent<{ syncId: string; imageKey?: string }>) => {
      if (event.detail.syncId !== "responsive-object-images" || !event.detail.imageKey) return;
      if (!returnData.images.some((image) => image.key === event.detail.imageKey)) return;

      activeImageKey = event.detail.imageKey;
      setReturnContext(getImageContext(activeImageKey) ?? getReferrerContext());
    }) as EventListener);
  } else if (returnLink?.getAttribute("href") === "/") {
    setReturnContext(getReferrerContext());
  }
</script>

<style>
  @reference "../../styles/global.css";

  .object-detail {
    @apply bg-paper text-text-primary;
  }

  .object-detail__header {
    @apply flex flex-col;

    gap: var(--spacing-12);
    padding: var(--spacing-40) var(--spacing-20);
  }

  .object-detail__eyebrow,
  .object-detail__metadata dt {
    @apply font-sans font-normal uppercase text-text-secondary;

    font-size: var(--text-small);
    line-height: 1;
  }

  .object-detail__metadata dt {
    letter-spacing: 0.04em;
  }

  .object-detail__header h1 {
    @apply font-display text-h3 font-normal text-text-primary;

    line-height: var(--text-h3--line-height);
  }

  .object-detail__subtitle {
    @apply font-sans text-body text-text-secondary;

    max-width: var(--container-text);
    line-height: var(--text-body--line-height);
  }

  .object-detail__content {
    @apply flex flex-col;

    gap: var(--spacing-40);
    padding: var(--spacing-64) var(--spacing-20);
  }

  .object-detail__sidebar {
    @apply flex w-full flex-col;

    gap: var(--spacing-40);
  }

  .object-detail__metadata {
    @apply m-0 w-full;
  }

  .object-detail__metadata-item {
    @apply flex flex-col;

    gap: var(--spacing-8);
    border-bottom: 1px solid var(--color-ash-grey);
    padding-block: var(--spacing-12);
  }

  .object-detail__metadata-item:first-child {
    padding-top: 0;
  }

  .object-detail__metadata dd {
    @apply m-0 whitespace-pre-line font-sans text-body text-text-primary;

    line-height: var(--text-body--line-height);
  }

  .object-detail__metadata :global(a) {
    color: inherit;
    text-decoration-line: underline;
    transition: none;
  }

  .object-detail__metadata :global(a:hover) {
    opacity: 0.8;
  }

  .object-detail__return-link {
    @apply inline-flex w-fit items-baseline font-sans text-body text-link no-underline;

    gap: 0.25em;
    border-bottom: 1px solid transparent;
    line-height: var(--text-body--line-height);
    transition: border-color 150ms var(--ease-default);
  }

  .object-detail__return-link:hover {
    border-bottom-color: currentColor;
  }

  .object-detail__return-link-arrow {
    @apply inline-block;

    transition: transform 150ms var(--ease-default);
  }

  .object-detail__return-link:hover .object-detail__return-link-arrow {
    transform: translateX(-3px);
  }

  .object-detail__body {
    @apply flex flex-col font-sans text-body text-text-primary;

    line-height: var(--text-body--line-height);
  }

  .object-detail__body :global(h1) {
    @apply font-display text-h3 font-normal text-text-primary;

    margin-block: var(--spacing-32) var(--spacing-12);
    line-height: var(--text-h3--line-height);
  }

  .object-detail__body :global(h2) {
    margin-block: var(--spacing-24) var(--spacing-8);
  }

  .object-detail__body :global(h1:first-child),
  .object-detail__body :global(h2:first-child) {
    margin-top: 0;
  }

  .object-detail__body :global(p + p) {
    margin-top: var(--spacing-16);
  }

  @media (min-width: 768px) {
    .object-detail__header {
      padding: var(--spacing-48) var(--spacing-32) var(--spacing-40);
    }

    .object-detail__header h1 {
      font-size: 2.5rem;
    }

    .object-detail__content {
      gap: var(--spacing-48);
      padding: var(--spacing-64) var(--spacing-32) var(--spacing-120);
    }
  }

  @media (min-width: 1440px) {
    .object-detail__header {
      padding-inline: var(--spacing-80);
    }

    .object-detail__header h1 {
      font-size: var(--text-h1);
      line-height: var(--text-h1--line-height);
    }

    .object-detail__content {
      display: grid;
      grid-template-columns: 415px minmax(0, 1fr);
      gap: 128px;
      padding: var(--spacing-64) var(--spacing-80) var(--spacing-120);
    }

    .object-detail__body {
      width: 100%;
      max-width: 80ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .object-detail__return-link,
    .object-detail__return-link-arrow {
      transition: none;
    }
  }
</style>
