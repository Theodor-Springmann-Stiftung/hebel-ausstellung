---
import type { CollectionEntry } from "astro:content";
import { getObjectRelationshipsByImage } from "../../lib/content";
import { markdownToPlainText, renderInlineMarkdown } from "../../lib/markdown";
import { getDedicatedHeroImage, getHeroImageSource, resolveContentImage } from "../../lib/object-images";

const { chapter } = Astro.props as { chapter: CollectionEntry<"chapters"> };
const image = getDedicatedHeroImage(chapter.data.hero);
const metadataImage = chapter.data.heroMetadata ? await resolveContentImage(chapter.data.heroMetadata) : undefined;
const metadata = metadataImage?.entry?.data;
const imageSource = await getHeroImageSource(image);
const object = metadataImage
  ? (await getObjectRelationshipsByImage()).get(metadataImage.asset.src)?.find((relationship) => relationship.object.data.slug)?.object
  : undefined;
const objectHref = object ? `/objekte/${object.data.slug}/` : undefined;
---

<header class="chapter-hero">
  <h1 class="chapter-hero__title">
    <span>Kapitel {Number(chapter.data.nummer)}</span>
    <span set:html={renderInlineMarkdown(chapter.data.titel)}></span>
  </h1>

  <div class="chapter-hero__image-frame">
    <img
      class="chapter-hero__image"
      src={imageSource.src}
      srcset={imageSource.srcset}
      sizes={imageSource.sizes}
      alt={markdownToPlainText(metadata?.altText || chapter.data.titel)}
      width={image.width}
      height={image.height}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  {(metadata?.beschriftung || objectHref) && (
    <div class="chapter-hero__caption">
      <div class="chapter-hero__caption-inner">
        {metadata?.beschriftung && <p class="chapter-hero__caption-title" set:html={renderInlineMarkdown(metadata.beschriftung)}></p>}
        {objectHref && <a class="chapter-hero__object-link" href={objectHref}>Zum Objekt <span class="chapter-hero__object-link-arrow" aria-hidden="true">→</span></a>}
      </div>
    </div>
  )}
</header>

<style>
  @reference "../../styles/global.css";

  .chapter-hero {
    @apply w-full overflow-hidden;

    background: var(--page-background, var(--color-paper));
  }

  .chapter-hero__title {
    @apply flex flex-col items-center font-display font-normal text-text-primary;

    gap: var(--spacing-8);
    padding: var(--spacing-20);
    font-size: var(--text-h1);
    line-height: var(--text-h1--line-height);
    text-align: center;
  }

  .chapter-hero__image-frame {
    display: flex;
    width: 100%;
    height: 360px;
    overflow: hidden;
    align-items: center;
  }

  .chapter-hero__image {
    width: 100%;
    height: 100%;
    max-width: none;
    flex: none;
    object-fit: cover;
    object-position: center;
  }

  .chapter-hero__caption {
    width: calc(100% - var(--spacing-20) * 2);
    margin-inline: auto;
    padding-block: var(--spacing-16);
  }

  .chapter-hero__caption-inner {
    @apply flex flex-col font-sans;

    gap: var(--spacing-4);
  }

  .chapter-hero__caption-title {
    font-size: var(--text-caption);
    line-height: 1.4;
  }

  .chapter-hero__caption :global(a) {
    overflow-wrap: anywhere;
  }

  .chapter-hero__object-link {
    @apply inline-flex w-fit items-baseline font-sans text-link no-underline;

    margin-top: var(--spacing-8);
    gap: 0.25em;
    border-bottom: 1px solid transparent;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    transition: border-color 150ms var(--ease-default);
  }

  .chapter-hero__object-link:hover {
    border-bottom-color: currentColor;
  }

  .chapter-hero__object-link-arrow {
    @apply inline-block;

    transition: transform 150ms var(--ease-default);
  }

  .chapter-hero__object-link:hover .chapter-hero__object-link-arrow {
    transform: translateX(3px);
  }

  @media (min-width: 768px) {
    .chapter-hero__title {
      padding: var(--spacing-40) var(--spacing-48);
      font-size: var(--text-h1);
    }

    .chapter-hero__image-frame {
      height: 650px;
      border-block: 0.5px solid var(--color-ink);
    }

    .chapter-hero__caption {
      width: min(var(--container-content), calc(100vw - 72px - 72px - var(--spacing-20) - var(--spacing-20)));
      padding-block: var(--spacing-24);
    }
  }

  @media (min-width: 1440px) {
    .chapter-hero__title {
      gap: var(--spacing-20);
      padding: var(--spacing-40) var(--spacing-80);
      font-size: var(--text-display);
      line-height: var(--text-display--line-height);
    }

    .chapter-hero__image-frame {
      height: 850px;
    }

    .chapter-hero__caption {
      width: min(var(--container-content), calc(100vw - 168.5px - 168.5px - var(--spacing-20) - var(--spacing-20)));
      padding-block: var(--spacing-20);
    }

    .chapter-hero__caption-inner {
      gap: var(--spacing-10, 10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-hero__object-link,
    .chapter-hero__object-link-arrow {
      transition: none;
    }
  }
</style>
