---
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from "astro:content";
import { subchapterHref } from "../../lib/content";
import { markdownToPlainText, renderInlineMarkdown } from "../../lib/markdown";
import { getNavigationImageSource, getThumbnailImage } from "../../lib/object-images";

const { chapter } = Astro.props as { chapter: CollectionEntry<"chapters"> };
const { Content } = await render(chapter);
const subchapters = await Promise.all(
  (chapter.data.unterkapitel ?? []).map(async (reference) => {
    const subchapter = await getEntry(reference);

    if (!subchapter) return undefined;

    const image = getThumbnailImage(subchapter.data.thumbnail);
    const imageSource = await getNavigationImageSource(
      image,
      "(min-width: 1440px) 624px, (min-width: 768px) calc((100vw - 84px) / 2), calc(100vw - 40px)",
    );

    return { subchapter, image, imageSource };
  }),
);
const availableSubchapters = subchapters.filter(Boolean);
---

<section class="chapter-overview" style={`--chapter-color: var(--chapter-${Number(chapter.data.nummer)})`}>
  <div class="chapter-overview__text"><Content /></div>

  {availableSubchapters.length > 0 && (
    <nav class="chapter-overview__navigation" aria-label={`${chapter.data.navTitel} Unterkapitel`}>
      <h2>Unterkapitel</h2>
      <ol class="chapter-overview__list">
        {availableSubchapters.map(({ subchapter, image, imageSource }) => (
          <li class="chapter-overview__card">
            <a href={subchapterHref(chapter.data.nummer, subchapter.data.nummer)}>
              <span
                class="chapter-overview__image-frame"
              >
                <img
                  class="chapter-overview__thumbnail"
                  src={imageSource.src}
                  srcset={imageSource.srcset}
                  sizes={imageSource.sizes}
                  alt={markdownToPlainText(subchapter.data.titel)}
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="chapter-overview__meta">
                <span class="chapter-overview__title" set:html={renderInlineMarkdown(subchapter.data.titel)}></span>
                <span class="chapter-overview__link">Weiterlesen <span class="chapter-overview__link-arrow" aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}
</section>

<style>
  @reference "../../styles/global.css";

  .chapter-overview {
    background: var(--content-background, var(--chapter-color, var(--color-paper)));
  }

  .chapter-overview__text {
    display: flex;
    padding-block: var(--spacing-48);
    flex-direction: column;
    gap: var(--spacing-24);
  }

  .chapter-overview__text :global(> p) {
    @apply font-sans text-lead text-text-primary;

    width: calc(100% - var(--spacing-40));
    max-width: var(--container-text);
    margin-inline: auto;
    line-height: var(--text-lead--line-height);
  }

  .chapter-overview__navigation {
    display: flex;
    padding: var(--spacing-48) var(--spacing-20) var(--spacing-64);
    flex-direction: column;
    gap: var(--spacing-32);
  }

  .chapter-overview__navigation h2 {
    @apply font-display font-normal text-text-primary;

    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
  }

  .chapter-overview__list {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-32);
    list-style: none;
  }

  .chapter-overview__card a {
    display: flex;
    color: var(--color-text-primary);
    flex-direction: column;
    gap: var(--spacing-16);
    text-decoration: none;
  }

  .chapter-overview__image-frame {
    display: flex;
    height: 200px;
    overflow: hidden;
    border: 0.5px solid var(--color-ink);
    background: #faf8e4;
    align-items: center;
  }

  .chapter-overview__thumbnail {
    width: 100%;
    height: 100%;
    max-width: none;
    flex: none;
    object-fit: cover;
    object-position: center;
    transition: transform 180ms ease-out;
  }

  .chapter-overview__meta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .chapter-overview__title {
    @apply font-display font-normal text-text-primary;

    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }

  .chapter-overview__link {
    @apply inline-flex w-fit items-baseline font-sans font-normal text-link;

    gap: 0.25em;
    border-bottom: 1px solid transparent;
    font-size: 0.75rem;
    line-height: 1.5;
    transition: border-color 150ms var(--ease-default);
  }

  .chapter-overview__link-arrow {
    @apply inline-block;

    transition: transform 150ms var(--ease-default);
  }

  .chapter-overview__card a:hover .chapter-overview__link {
    border-bottom-color: currentColor;
  }

  .chapter-overview__card a:hover .chapter-overview__thumbnail {
    transform: scale(1.015);
  }

  .chapter-overview__card a:hover .chapter-overview__link-arrow {
    transform: translateX(3px);
  }

  .chapter-overview__card a:focus-visible {
    outline-offset: var(--spacing-4);
  }

  @media (min-width: 768px) {
    .chapter-overview__text {
      padding-block: var(--spacing-64);
      gap: var(--spacing-40);
    }

    .chapter-overview__text :global(> p) {
      width: 522px;
    }

    .chapter-overview__navigation {
      padding: var(--spacing-80) var(--spacing-32);
      gap: var(--spacing-40);
    }

    .chapter-overview__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--spacing-20);
      row-gap: var(--spacing-48);
    }

    .chapter-overview__card a {
      gap: var(--spacing-24);
    }

    .chapter-overview__image-frame {
      height: 240px;
    }

    .chapter-overview__meta {
      gap: var(--spacing-8);
    }

    .chapter-overview__title {
      font-size: var(--text-h3);
    }

    .chapter-overview__link {
      font-size: var(--text-body-medium);
    }
  }

  @media (min-width: 1440px) {
    .chapter-overview__text {
      gap: var(--spacing-32);
    }

    .chapter-overview__text :global(> p) {
      width: var(--container-text);
    }

    .chapter-overview__navigation {
      max-width: var(--container-wide);
      margin-inline: auto;
      padding: var(--spacing-80) var(--spacing-80) var(--spacing-120);
    }

    .chapter-overview__list {
      column-gap: var(--spacing-32);
      row-gap: var(--spacing-32);
    }

    .chapter-overview__image-frame {
      height: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-overview__thumbnail,
    .chapter-overview__link,
    .chapter-overview__link-arrow {
      transition: none;
    }
  }
</style>
