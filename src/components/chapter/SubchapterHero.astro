---
import type { CollectionEntry } from "astro:content";
import { getObjectRelationshipsByImage } from "../../lib/content";
import { markdownToPlainText, renderInlineMarkdown } from "../../lib/markdown";
import { getDedicatedHeroImage, getHeroImageSource, resolveContentImage } from "../../lib/object-images";

const { chapter, subchapter } = Astro.props as {
  chapter: CollectionEntry<"chapters">;
  subchapter: CollectionEntry<"subchapters">;
};
const image = getDedicatedHeroImage(subchapter.data.hero);
const metadataImage = subchapter.data.heroMetadata ? await resolveContentImage(subchapter.data.heroMetadata) : undefined;
const imageSource = await getHeroImageSource(image);
const object = metadataImage
  ? (await getObjectRelationshipsByImage()).get(metadataImage.asset.src)?.find((relationship) => relationship.object.data.slug)?.object
  : undefined;
const objectHref = object ? `/objekte/${object.data.slug}/` : undefined;
---

<header class="subchapter-hero">
  <div class="subchapter-hero__image-frame">
    <img
      class="subchapter-hero__image"
      src={imageSource.src}
      srcset={imageSource.srcset}
      sizes={imageSource.sizes}
      alt={markdownToPlainText(metadataImage?.entry?.data.altText || subchapter.data.titel)}
      width={image.width}
      height={image.height}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <div class="subchapter-hero__gradient"></div>
  <div class="subchapter-hero__content">
    <div class="subchapter-hero__content-inner">
      <p class="subchapter-hero__chapter">Kapitel {chapter.data.nummer}: {chapter.data.navTitel}</p>
      <h1 class="subchapter-hero__title" set:html={renderInlineMarkdown(subchapter.data.titel)}></h1>
    </div>
  </div>
</header>

{(metadataImage?.entry?.data.beschriftung || objectHref) && (
  <div class="subchapter-hero-caption">
    {metadataImage?.entry?.data.beschriftung && <p class="subchapter-hero-caption__title" set:html={renderInlineMarkdown(metadataImage.entry.data.beschriftung)}></p>}
    {objectHref && <a class="subchapter-hero-caption__link" href={objectHref}>Zum Objekt <span class="subchapter-hero-caption__link-arrow" aria-hidden="true">→</span></a>}
  </div>
)}

<style>
  @reference "../../styles/global.css";

  .subchapter-hero {
    position: relative;
    display: flex;
    width: 100%;
    height: 515px;
    overflow: hidden;
    align-items: flex-end;
    background: var(--color-oat);
  }

  .subchapter-hero__image-frame,
  .subchapter-hero__gradient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .subchapter-hero__image-frame {
    display: flex;
    overflow: hidden;
    align-items: center;
  }

  .subchapter-hero__image {
    width: 100%;
    height: 100%;
    max-width: none;
    flex: none;
    object-fit: cover;
    object-position: center;
  }

  .subchapter-hero__gradient {
    background: linear-gradient(to top, #26251e 8%, rgb(38 37 30 / 40%) 41%, rgb(38 37 30 / 0%) 92%);
  }

  .subchapter-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    color: var(--color-paper);
  }

  .subchapter-hero__content-inner {
    display: flex;
    width: 100%;
    padding: var(--spacing-40) var(--spacing-20);
    flex-direction: column;
    gap: var(--spacing-20);
  }

  .subchapter-hero-caption {
    display: flex;
    padding: var(--spacing-16) var(--spacing-20);
    flex-direction: column;
    gap: var(--spacing-4);
    font-family: var(--font-sans);
    background: var(--content-background, var(--page-background, var(--color-paper)));
  }

  .subchapter-hero-caption__title { font-size: var(--text-caption); }
  .subchapter-hero-caption__link { display: inline-flex; width: fit-content; margin-top: var(--spacing-8); align-items: baseline; gap: 0.25em; border-bottom: 1px solid transparent; color: var(--color-link); font-family: var(--font-sans); font-size: var(--text-small); line-height: var(--text-small--line-height); text-decoration: none; transition: border-color 150ms var(--ease-default); }
  .subchapter-hero-caption__link-arrow { display: inline-block; transition: transform 150ms var(--ease-default); }
  .subchapter-hero-caption__link:hover { border-bottom-color: currentColor; }
  .subchapter-hero-caption__link:hover .subchapter-hero-caption__link-arrow { transform: translateX(3px); }

  @media (min-width: 768px) {
    .subchapter-hero-caption { padding: var(--spacing-24) var(--spacing-32); }
  }

  @media (min-width: 1440px) {
    .subchapter-hero-caption { padding-inline: var(--spacing-80); }
  }

  @media (prefers-reduced-motion: reduce) {
    .subchapter-hero-caption__link,
    .subchapter-hero-caption__link-arrow {
      transition: none;
    }
  }

  .subchapter-hero__chapter {
    @apply font-sans text-caption font-normal;

    line-height: normal;
  }

  .subchapter-hero__title {
    @apply font-display text-display font-normal;

    max-width: 985px;
    color: inherit;
    line-height: var(--text-display--line-height);
  }

  :global(html[data-contrast="high"]) .subchapter-hero {
    display: grid;
    height: auto;
    overflow: visible;
    background: var(--content-background, var(--color-paper));
    align-items: initial;
  }

  :global(html[data-contrast="high"]) .subchapter-hero__image-frame {
    position: relative;
    grid-row: 2;
    height: 515px;
  }

  :global(html[data-contrast="high"]) .subchapter-hero__gradient {
    display: none;
  }

  :global(html[data-contrast="high"]) .subchapter-hero__content {
    grid-row: 1;
    background: var(--chapter-color, var(--color-paper));
    color: var(--color-text-primary);
  }

  @media (min-width: 768px) {
    .subchapter-hero__image-frame {
      border-block: 0.5px solid var(--color-ink);
    }

    .subchapter-hero__content-inner {
      padding-inline: var(--spacing-32);
    }
  }

  @media (min-width: 1440px) {
    .subchapter-hero__content-inner {
      max-width: var(--container-wide);
      margin-inline: auto;
      padding-inline: var(--spacing-80);
    }
  }
</style>
