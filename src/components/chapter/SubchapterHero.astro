---
import type { CollectionEntry } from "astro:content";
import { getObjectRelationshipsByImage } from "../../lib/content";
import { markdownToPlainText, renderInlineMarkdown } from "../../lib/markdown";
import { getDedicatedHeroImage, getHeroImageSource, resolveContentImage } from "../../lib/object-images";

const { chapter, subchapter } = Astro.props as {
  chapter: CollectionEntry<"chapters">;
  subchapter: CollectionEntry<"subchapters">;
};
const image = getDedicatedHeroImage(subchapter.data.hero);
const metadataImage = subchapter.data.heroMetadata ? await resolveContentImage(subchapter.data.heroMetadata) : undefined;
const imageSource = await getHeroImageSource(image);
const object = metadataImage
  ? (await getObjectRelationshipsByImage()).get(metadataImage.asset.src)?.find((relationship) => relationship.object.data.slug)?.object
  : undefined;
const objectHref = object ? `/objekte/${object.data.slug}/` : undefined;
const objectMetadata = object
  ? [object.data.urheber, object.data.datierung, object.data.materialTechnik, object.data.institution]
      .filter(Boolean)
      .map((value) => renderInlineMarkdown(value))
      .join(", ")
  : "";
---

<header class="subchapter-hero">
  <div class="subchapter-hero__image-frame">
    <img
      class="subchapter-hero__image"
      src={imageSource.src}
      srcset={imageSource.srcset}
      sizes={imageSource.sizes}
      alt={markdownToPlainText(metadataImage?.entry?.data.altText || subchapter.data.titel)}
      width={image.width}
      height={image.height}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <div class="subchapter-hero__gradient"></div>
  <div class="subchapter-hero__content">
    <p class="subchapter-hero__chapter">Kapitel {chapter.data.nummer}: {chapter.data.navTitel}</p>
    <h1 class="subchapter-hero__title" set:html={renderInlineMarkdown(subchapter.data.titel)}></h1>
  </div>
</header>

{(metadataImage?.entry?.data.beschriftung || objectMetadata || objectHref) && (
  <div class="subchapter-hero-caption">
    {metadataImage?.entry?.data.beschriftung && <p class="subchapter-hero-caption__title" set:html={renderInlineMarkdown(metadataImage.entry.data.beschriftung)}></p>}
    {objectMetadata && <p class="subchapter-hero-caption__credit" set:html={objectMetadata}></p>}
    {objectHref && <a class="subchapter-hero-caption__link" href={objectHref}>Zum Objekt <span aria-hidden="true">→</span></a>}
  </div>
)}

<style>
  @reference "../../styles/global.css";

  .subchapter-hero {
    position: relative;
    display: flex;
    width: 100%;
    height: 515px;
    overflow: hidden;
    align-items: flex-end;
    background: var(--color-oat);
  }

  .subchapter-hero__image-frame,
  .subchapter-hero__gradient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .subchapter-hero__image-frame {
    display: flex;
    overflow: hidden;
    align-items: center;
  }

  .subchapter-hero__image {
    width: 100%;
    height: 100%;
    max-width: none;
    flex: none;
    object-fit: cover;
    object-position: center;
  }

  .subchapter-hero__gradient {
    background: linear-gradient(to top, #26251e 8%, rgb(38 37 30 / 40%) 41%, rgb(38 37 30 / 0%) 92%);
  }

  .subchapter-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    padding: var(--spacing-40) var(--spacing-20);
    color: var(--color-paper);
    flex-direction: column;
    gap: var(--spacing-20);
  }

  .subchapter-hero-caption {
    display: flex;
    padding: var(--spacing-16) var(--spacing-20);
    flex-direction: column;
    gap: var(--spacing-4);
    font-family: var(--font-mono);
  }

  .subchapter-hero-caption__title { font-size: var(--text-caption); }
  .subchapter-hero-caption__credit { color: var(--color-stone); font-size: var(--text-caption-small); }
  .subchapter-hero-caption__link { width: fit-content; margin-top: var(--spacing-8); color: var(--color-link); font-family: var(--font-sans); text-decoration: none; }
  .subchapter-hero-caption__link:hover { text-decoration: underline; }

  @media (min-width: 768px) {
    .subchapter-hero-caption { padding: var(--spacing-24) var(--spacing-32); }
  }

  @media (min-width: 1440px) {
    .subchapter-hero-caption { padding-inline: var(--spacing-80); }
  }

  .subchapter-hero__chapter {
    @apply font-mono text-caption font-normal;

    line-height: normal;
  }

  .subchapter-hero__title {
    @apply font-display text-display font-normal;

    max-width: 985px;
    color: inherit;
    line-height: var(--text-display--line-height);
  }

  @media (min-width: 768px) {
    .subchapter-hero__content {
      padding-inline: var(--spacing-32);
    }
  }

  @media (min-width: 1440px) {
    .subchapter-hero__content {
      max-width: var(--container-wide);
      margin-inline: auto;
      padding-inline: var(--spacing-80);
    }
  }
</style>
