---
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from "astro:content";
import Gallery from "../gallery/Gallery.astro";
import seal from "../../assets/Meta/Hebel_Wachssiegel.png";
import { findContentImage, getGalleryImageSource } from "../../lib/object-images";
import { getObjectRelationshipsByImage } from "../../lib/content";
import { renderInlineMarkdown } from "../../lib/markdown";

type Section = CollectionEntry<"chapters"> | CollectionEntry<"subchapters">;

const { section } = Astro.props as { section: Section };
const chapterNumber = Number(section.data.nummer.split(".")[0]);
const showProteusSeal = chapterNumber === 5;
const { Content } = await render(section);
const hasIntroContent = Boolean(section.body?.trim());
const objectRelationshipsByImage = await getObjectRelationshipsByImage();

const galleries = await Promise.all(
  (section.data.galerien ?? []).map(async (galleryReference) => {
    const gallery = await getEntry(galleryReference);

    if (!gallery) return undefined;

    const { Content: GalleryContent } = await render(gallery);
    const bilder = (
      await Promise.all(
        gallery.data.bilder.map(async (imageReferences) => {
          const imageEntries = (await Promise.all(imageReferences.map(findContentImage))).filter(Boolean);

          return Promise.all(
            imageEntries.map(async (imageEntry) => {
              const metadata = imageEntry.entry?.data;
              const objectRelationships = objectRelationshipsByImage.get(imageEntry.asset.src) ?? [];

              return {
                src: await getGalleryImageSource(imageEntry.asset),
                alt: metadata?.altText,
                beschriftung: metadata?.beschriftung,
                objekte: objectRelationships
                  .map(({ object, position, beschriftung }) => ({
                    slug: object.data.slug,
                    position,
                    beschriftung,
                    transkription: object.data.transkription,
                    transkriptionsart: object.data.transkriptionsart,
                    titel: object.data.titel ?? "",
                    urheber: object.data.urheber,
                    datierung: object.data.datierung,
                    materialTechnik: object.data.materialTechnik,
                    institution: object.data.institution,
                  })),
              };
            }),
          );
        }),
      )
    ).filter((images) => images.length > 0);

    return { gallery, GalleryContent, bilder };
  }),
);
---

{(hasIntroContent || showProteusSeal) && (
  <section class:list={["section-intro", { "section-intro--with-seal": showProteusSeal }]} style={`--chapter-color: var(--chapter-${chapterNumber})`}>
    <div class="section-intro__layout">
      {showProteusSeal && (
        <figure class="section-intro__seal">
          <img
            src={seal.src}
            width={seal.width}
            height={seal.height}
            alt="Hebels rotes Wachssiegel mit dem Proteus-Symbol"
            loading="eager"
            decoding="async"
          />
          <figcaption>Hebels Wachssiegel mit dem Proteus-Symbol</figcaption>
        </figure>
      )}
      {hasIntroContent && <div class="section-intro__text"><Content /></div>}
    </div>
  </section>
)}

{galleries.filter(Boolean).map(({ gallery, GalleryContent, bilder }, index) => (
  <section class="section-gallery" id={String(index + 1)} style={`--chapter-color: var(--chapter-${chapterNumber})`}>
    <span class="section-gallery__search-anchor" id={`gallery-${gallery.id}`} aria-hidden="true"></span>
    {bilder.length > 0 ? (
      <Gallery
        titel={gallery.data.titel}
        beschriftung={gallery.data.beschriftung}
        untertitel={gallery.data.untertitel}
        folienbeschriftung={gallery.data.folienbeschriftung}
        folienbeschriftungen={gallery.data.folienbeschriftungen}
        bildabstand={gallery.data.bildabstand}
        positionsangaben={gallery.data.positionsangaben}
        chapterNumber={chapterNumber}
        bilder={bilder}
      />
    ) : (
      <header class="section-gallery__text-header">
        <h2 set:html={renderInlineMarkdown(gallery.data.titel)}></h2>
        {gallery.data.beschriftung && <p set:html={renderInlineMarkdown(gallery.data.beschriftung)}></p>}
        {gallery.data.untertitel && <p set:html={renderInlineMarkdown(gallery.data.untertitel)}></p>}
      </header>
    )}
    <div class="section-gallery__body"><GalleryContent /></div>
  </section>
))}

<style>
  @reference "../../styles/global.css";

  .section-gallery__search-anchor {
    display: block;
    width: 0;
    height: 0;
    scroll-margin-top: 110px;
  }

  .section-intro {
    background: var(--content-background, var(--chapter-color, var(--color-paper)));
  }

  .section-gallery {
    background: var(--content-background, var(--chapter-color, var(--color-paper)));
  }

  .section-gallery__body {
    background: var(--content-background, var(--chapter-color, var(--color-paper)));
  }

  .section-gallery__text-header {
    display: flex;
    padding: var(--spacing-48) var(--spacing-20) var(--spacing-24);
    background: var(--content-background, var(--chapter-color, var(--color-paper)));
    flex-direction: column;
    gap: var(--spacing-12);
  }

  .section-gallery__text-header h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: normal;
    line-height: var(--text-h2--line-height);
  }

  .section-gallery__text-header p {
    max-width: var(--container-text);
    font-family: var(--font-sans);
    font-size: var(--text-caption);
  }

  .section-gallery__body {
    @apply flex flex-col;
  }

  .section-intro {
    padding: var(--spacing-48) var(--spacing-20);
  }

  .section-intro--with-seal .section-intro__layout {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-32);
  }

  .section-intro__seal {
    display: flex;
    width: 100%;
    margin: 0;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-16);
  }

  .section-intro__seal img {
    width: min(200px, 60vw);
    aspect-ratio: 1;
    object-fit: contain;
  }

  .section-intro__seal figcaption {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    text-align: center;
  }

  .section-intro__text :global(> p) {
    max-width: var(--container-text);
    margin-inline: auto;
  }

  .section-intro__text :global(> p),
  .section-gallery__body :global(> p) {
    @apply font-sans text-body text-text-primary;

    line-height: var(--text-body--line-height);
  }

  .section-gallery__body :global(> p) {
    hyphens: auto;
  }

  .section-intro__text :global(> p) {
    font-size: var(--text-body);
  }

  .section-gallery__body :global(> p) {
    width: 100%;
    max-width: var(--container-text);
    margin-inline: auto;
    padding-inline: var(--spacing-20);
  }

  .section-gallery__body :global(a) {
    color: inherit;
    text-decoration-line: underline;
    transition: none;
  }

  .section-gallery__body :global(a:hover) {
    opacity: 0.8;
  }

  .section-gallery__body :global(> p:first-of-type) {
    padding-top: var(--spacing-48);
  }

  .section-gallery__body :global(> p + p) {
    margin-top: var(--spacing-16);
  }

  .section-gallery__body :global(> p:last-of-type) {
    padding-bottom: var(--spacing-48);
  }

  .section-gallery__body :global(> .footnotes) {
    @apply font-sans text-text-secondary;

    width: 100%;
    max-width: var(--container-text);
    margin-inline: auto;
    padding: 0 var(--spacing-20) var(--spacing-48);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  .section-gallery__body :global(> .footnotes > h2) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .section-gallery__body :global(> .footnotes ol) {
    margin: 0;
    padding-left: 0;
    list-style: none;
    counter-reset: gallery-footnote;
  }

  .section-gallery__body :global(> .footnotes li) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--spacing-16);
    counter-increment: gallery-footnote;
  }

  .section-gallery__body :global(> .footnotes li::before) {
    content: counter(gallery-footnote);
  }

  .section-gallery__body :global(> .footnotes p) {
    max-width: 70ch;
    margin: 0;
  }

  .section-gallery__body :global(> blockquote) {
    width: calc(100% - var(--spacing-48));
    max-width: 840px;
    margin: var(--spacing-40) auto;
    border-left: 0.5px solid var(--color-ink);
    padding-left: var(--spacing-24);
  }

  .section-gallery + .section-gallery::before {
    display: block;
    height: var(--spacing-80);
    margin-inline: var(--spacing-20);
    border-top: 0.5px solid var(--gallery-divider-color, var(--color-ink));
    content: "";
    transform: translateY(var(--spacing-40));
  }

  .section-gallery__body :global(> blockquote > p) {
    @apply font-display font-normal not-italic;

    margin: 0;
    font-size: var(--text-quote);
    line-height: var(--text-quote--line-height);
    letter-spacing: var(--text-quote--letter-spacing);
  }

  .section-gallery__body :global(> blockquote > p + p) {
    margin-top: 0.5em;
  }

  .section-gallery__body :global(> blockquote:has(> p:nth-child(3)) > p:nth-last-child(2)) {
    @apply flex items-center font-display text-lead font-normal not-italic;

    gap: var(--spacing-12);
    margin-top: var(--spacing-24);
    line-height: 1.25;
    letter-spacing: 0.01em;
  }

  .section-gallery__body :global(> blockquote:has(> p:nth-child(3)) > p:nth-last-child(2)::before) {
    @apply block flex-none rounded-full;

    width: var(--spacing-56);
    height: var(--spacing-56);
    flex-basis: var(--spacing-56);
    border: 0.5px solid var(--color-ink);
    background-image: url("../../assets/Meta/Hebel_Portraet_Mueller.jpg");
    background-position: 68% 50%;
    background-size: auto 100%;
    content: "";
  }

  .section-gallery__body :global(> blockquote:has(> p:nth-child(3)) > p:last-child) {
    margin-left: calc(var(--spacing-56) + var(--spacing-12));
    margin-top: 2px;
    @apply font-sans text-caption font-normal not-italic text-text-secondary;

    line-height: normal;
  }

  @media (min-width: 768px) {
    .section-gallery__body :global(> p) {
      padding-inline: var(--spacing-32);
      max-width: 586px;
    }

    .section-gallery__body :global(> p:first-of-type) {
      padding-top: var(--spacing-64);
    }

    .section-gallery__body :global(> p:last-of-type) {
      padding-bottom: var(--spacing-64);
    }

    .section-gallery__body :global(> .footnotes) {
      max-width: 586px;
      padding: 0 var(--spacing-32) var(--spacing-64);
    }

    .section-gallery__body :global(> blockquote) {
      width: calc(100% - var(--spacing-64));
      margin-block: var(--spacing-64);
      margin-inline: auto;
      padding-left: var(--spacing-48);
    }

    .section-intro {
      padding-block: var(--spacing-64);
    }

    .section-intro__text :global(> p) {
      max-width: 522px;
      font-size: var(--text-lead);
      line-height: var(--text-lead--line-height);
    }

    .section-intro--with-seal .section-intro__layout {
      display: grid;
      grid-template-columns: 180px minmax(0, 522px);
      align-items: start;
      justify-content: center;
      gap: var(--spacing-32);
    }

    .section-intro__seal img {
      width: 180px;
    }

    .section-gallery + .section-gallery::before {
      margin-inline: var(--spacing-32);
    }

    .section-gallery__body :global(> blockquote > p) {
      font-size: var(--text-quote);
    }

    .section-gallery__body :global(> blockquote:has(> p:nth-child(3)) > p:nth-last-child(2)) {
      gap: var(--spacing-16);
      margin-top: var(--spacing-32);
      font-size: var(--text-h5);
    }

    .section-gallery__body :global(> blockquote:has(> p:nth-child(3)) > p:nth-last-child(2)::before) {
      width: var(--spacing-40);
      height: var(--spacing-40);
      flex-basis: var(--spacing-40);
    }

    .section-gallery__body :global(> blockquote:has(> p:nth-child(3)) > p:last-child) {
      margin-left: calc(var(--spacing-40) + var(--spacing-16));
      font-size: 1rem;
    }
  }

  @media (min-width: 1440px) {
    .section-gallery__body :global(> p) {
      padding-inline: 0;
      max-width: var(--container-text);
    }

    .section-intro {
      padding-block: var(--spacing-80);
    }

    .section-gallery__body :global(> .footnotes) {
      max-width: var(--container-text);
      padding-inline: 0;
    }

    .section-intro__text :global(> p) {
      max-width: 840px;
    }

    .section-intro--with-seal .section-intro__layout {
      grid-template-columns: 220px minmax(0, 840px);
      gap: var(--spacing-48);
    }

    .section-intro__seal img {
      width: 220px;
    }

    .section-gallery__body :global(> blockquote) {
      margin-block: var(--spacing-80);
    }

    .section-gallery + .section-gallery::before {
      max-width: 1060px;
      margin-inline: auto;
    }

    .section-gallery__body :global(> blockquote:has(> p:nth-child(3)) > p:nth-last-child(2)) {
      margin-top: 38px;
    }

    .section-gallery__body :global(> blockquote:has(> p:nth-child(3)) > p:nth-last-child(2)::before) {
      width: var(--spacing-48);
      height: var(--spacing-48);
      flex-basis: var(--spacing-48);
    }

    .section-gallery__body :global(> blockquote:has(> p:nth-child(3)) > p:last-child) {
      margin-left: calc(var(--spacing-48) + var(--spacing-16));
    }
  }
</style>
