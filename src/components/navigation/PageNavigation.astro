---
type NavigationItem = {
  label: string;
  href: string;
};

const { previous, next } = Astro.props as {
  previous?: NavigationItem;
  next?: NavigationItem;
};
---

{(previous || next) && (
  <nav class="page-navigation" aria-label="Vorherige und nächste Seite">
    <div class="page-navigation__inner">
      <div class="page-navigation__column page-navigation__column--previous">
        {previous && (
          <a class="page-navigation__link page-navigation__link--previous" href={previous.href}>
            <span class="page-navigation__arrow" aria-hidden="true">←</span><span>{previous.label}</span>
          </a>
        )}
      </div>
      <div class="page-navigation__column page-navigation__column--next">
        {next && (
          <a class="page-navigation__link page-navigation__link--next" href={next.href}>
            <span>{next.label}</span><span class="page-navigation__arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>
  </nav>
)}

<style>
  @reference "../../styles/global.css";

  .page-navigation {
    width: 100%;
    border-top: 0.5px solid var(--page-navigation-border-color, var(--color-ink));
    background: var(--content-background, var(--page-background, var(--color-paper)));
  }

  .page-navigation__inner {
    display: grid;
    width: 100%;
    max-width: var(--container-wide);
    min-height: 100px;
    margin-inline: auto;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .page-navigation__column {
    display: flex;
    min-width: 0;
    align-items: center;
    padding: 34px var(--spacing-20);
  }

  .page-navigation__column--next {
    justify-content: flex-end;
    text-align: right;
  }

  .page-navigation__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    border-bottom: 1px solid transparent;
    color: var(--page-navigation-link-color, var(--color-link));
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 400;
    line-height: var(--text-body--line-height);
    text-decoration: none;
    transition: border-color 150ms var(--ease-default);
  }

  .page-navigation__arrow {
    display: inline-block;
    transition: transform 150ms var(--ease-default);
  }

  .page-navigation__link:hover {
    border-bottom-color: currentColor;
  }

  .page-navigation__link--previous:hover .page-navigation__arrow {
    transform: translateX(-3px);
  }

  .page-navigation__link--next:hover .page-navigation__arrow {
    transform: translateX(3px);
  }

  @media (min-width: 768px) {
    .page-navigation__column {
      padding-inline: var(--spacing-32);
    }

    .page-navigation__link {
      font-size: var(--text-lead);
      line-height: var(--text-lead--line-height);
    }
  }

  @media (min-width: 1440px) {
    .page-navigation__column {
      padding-inline: 72px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-navigation__link,
    .page-navigation__arrow {
      transition: none;
    }
  }
</style>
