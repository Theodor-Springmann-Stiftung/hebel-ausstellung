---
import { markdownToPlainText, renderInlineMarkdown, serializeForScript } from "../../lib/markdown";
import { objectHref } from "../../lib/content";
import type { GalleryImageSource } from "../../lib/object-images";

export type GalleryObject = {
  slug?: string;
  position?: "Links" | "Rechts" | "Vorne";
  imageKey?: string;
  beschriftung?: string;
  transkription: boolean;
  transkriptionsart: "Transkription" | "Übersetzung";
  titel: string;
  urheber?: string;
  datierung?: string;
  materialTechnik?: string;
  institution?: string;
};

export type GalleryImage = {
  src: GalleryImageSource;
  alt?: string;
  beschriftung?: string;
  objekte?: GalleryObject[];
};

type CaptionItem = {
  titleHtml: string;
  textHtml: string;
  href?: string;
  linkLabel?: string;
  links?: Array<{ href: string; label: string }>;
  objectKey?: string;
  position?: "Links" | "Rechts" | "Vorne";
};

export type GalleryProps = {
  titel: string;
  beschriftung?: string;
  untertitel?: string;
  folienbeschriftung?: string;
  folienbeschriftungen?: Array<{
    folie: number;
    beschriftung: string;
    unterbeschriftungen: Array<string | { bild: number; beschriftung: string }>;
  }>;
  bildabstand?: "normal" | "weit";
  positionsangaben?: boolean;
  chapterNumber: number;
  bilder: GalleryImage[][];
};

const props = Astro.props as GalleryProps;
const {
  titel,
  beschriftung,
  untertitel,
  folienbeschriftung,
  folienbeschriftungen = [],
  bildabstand = "normal",
  chapterNumber,
  bilder,
} = props;
const isMultiSlide = bilder.length > 1;
const slideCaptionsByIndex = new Map(folienbeschriftungen.map((caption) => [caption.folie - 1, caption]));
const imagePositionLabel = (imageIndex: number, imageCount: number) => {
  if (imageCount === 2) return imageIndex === 0 ? "Links" : "Rechts";
  if (imageCount === 3) return ["Links", "Mitte", "Rechts"][imageIndex];
  return `Bild ${imageIndex + 1}`;
};

const getImageCaptionItems = (image: GalleryImage): CaptionItem[] => {
  if (image.objekte?.length) {
    const hasMultipleObjects = image.objekte.length > 1;

    return image.objekte.map((object) => {
      const captionTitle = hasMultipleObjects
        ? (object.beschriftung ?? object.titel)
        : (image.beschriftung ?? object.beschriftung ?? object.titel);

      return {
        titleHtml: renderInlineMarkdown(captionTitle),
        textHtml: "",
        href: object.slug ? objectHref(object.slug, {
          position: object.position,
          imageKey: object.imageKey,
        }) : undefined,
        linkLabel: object.transkription ? `Zum Objekt (mit ${object.transkriptionsart})` : "Zum Objekt",
        objectKey: object.slug,
        position: object.position,
      };
    });
  }

  if (image.beschriftung) {
    return [
      {
        titleHtml: renderInlineMarkdown(image.beschriftung),
        textHtml: "",
      },
    ];
  }

  return [];
};

const getSlideCaptionItems = (images: GalleryImage[], slideIndex: number) => {
  const imageCaptions = images.flatMap((image, imageIndex) =>
    getImageCaptionItems(image)
      .map((caption) => ({ ...caption, imageIndex })),
  );
  const distinctObjectKeys = new Set(imageCaptions.flatMap((caption) => caption.objectKey ? [caption.objectKey] : []));
  const hasMultipleObjects = distinctObjectKeys.size > 1;
  const hasPositionPrefix = (caption: string) => /^(Links|Rechts|Mitte|Vorne|Bild \d+):/i.test(caption);

  const captions = imageCaptions.map(({ imageIndex, ...caption }) => {
    const positionLabel = images.length > 1
      ? imagePositionLabel(imageIndex, images.length)
      : caption.position;

    return {
      ...caption,
      titleHtml: hasMultipleObjects && caption.objectKey && positionLabel && !hasPositionPrefix(caption.titleHtml)
        ? `${positionLabel}: ${caption.titleHtml}`
        : caption.titleHtml,
    };
  });

  const seenObjects = new Set<string>();
  const uniqueCaptions = captions.filter((caption) => {
    if (!caption.objectKey) return true;
    if (seenObjects.has(caption.objectKey)) return false;
    seenObjects.add(caption.objectKey);
    return true;
  });
  const objectCaptions = uniqueCaptions.filter((caption) => caption.objectKey);
  const hasSingleObject = objectCaptions.length === 1;
  const individualCaptions = hasSingleObject
    ? uniqueCaptions.filter((caption) => !caption.objectKey)
    : uniqueCaptions;
  const singleObjectLink = hasSingleObject && objectCaptions[0].href
    ? [{ href: objectCaptions[0].href, label: objectCaptions[0].linkLabel ?? "Zum Objekt" }]
    : [];

  const withSharedCaption = (caption: string): CaptionItem[] => [
    {
      titleHtml: renderInlineMarkdown(caption),
      textHtml: "",
      links: singleObjectLink,
    },
    ...individualCaptions,
  ];

  const slideCaption = slideCaptionsByIndex.get(slideIndex);
  if (slideCaption) {
    return withSharedCaption(slideCaption.beschriftung);
  }

  if (folienbeschriftung) {
    return withSharedCaption(folienbeschriftung);
  }

  if (hasSingleObject) {
    return [...individualCaptions, objectCaptions[0]];
  }

  return uniqueCaptions.length > 0
    ? uniqueCaptions
    : [{ titleHtml: renderInlineMarkdown(beschriftung), textHtml: "" }];
};

const slides = bilder.map((images, index) => ({
  index,
  images: images.map((image) => ({
    src: image.src.src,
    srcset: image.src.srcset,
    sizes: image.src.sizes,
    peekSrc: image.src.peekSrc,
    alt: markdownToPlainText(image.alt),
  })),
  captions: getSlideCaptionItems(images, index),
}));

const firstSlide = slides[0];
const nextSlide = slides[1] ?? firstSlide;
---

<section class:list={["gallery", isMultiSlide ? "gallery--multi" : "gallery--single", { "gallery--wide-image-gap": bildabstand === "weit" }]} style={`--chapter-color: var(--chapter-${chapterNumber})`} data-gallery aria-roledescription={isMultiSlide ? "carousel" : undefined} aria-label={markdownToPlainText(titel)}>
  <div class="gallery__title-section">
    <h2 class="gallery__title" set:html={renderInlineMarkdown(titel)}></h2>
  </div>

  <div class="gallery__stage select-none">
    {isMultiSlide && (
      <button class="gallery__button gallery__button--prev" type="button" data-gallery-prev aria-label="Vorherige Folie" disabled>
        <svg class="gallery__button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M19 12H5m6-6-6 6 6 6" />
        </svg>
      </button>
    )}

    {isMultiSlide && (
      <div class="gallery__peek gallery__peek--prev is-empty" aria-hidden="true" data-gallery-peek-prev>
        <img src={firstSlide.images[0].peekSrc} alt="" draggable="false" data-gallery-peek-prev-image />
      </div>
    )}

    <figure class="gallery__frame">
      <div class="gallery__mat" data-gallery-images data-image-count={firstSlide.images.length}>
        {firstSlide.images.map((image) => (
          <img
            class="gallery__image"
            src={image.src}
            srcset={image.srcset}
            sizes={image.sizes}
            alt={image.alt}
            draggable="false"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </figure>

    {isMultiSlide && (
      <div class="gallery__peek gallery__peek--next" class:list={{ "is-empty": slides.length < 2 }} aria-hidden="true" data-gallery-peek-next>
        <img src={nextSlide.images[0].peekSrc} alt="" draggable="false" data-gallery-peek-next-image />
      </div>
    )}

    {isMultiSlide && (
      <button class="gallery__button gallery__button--next" type="button" data-gallery-next aria-label="Nächste Folie">
        <svg class="gallery__button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </button>
    )}
  </div>

  <div class="gallery__caption-section" data-gallery-caption aria-live="polite">
    {isMultiSlide && (
      <div class="gallery__pagination select-none">
        <div class="gallery__dots" data-gallery-dots>
          {slides.map((slide) => <button class="gallery__dot" type="button" data-gallery-dot={slide.index} aria-label={`Folie ${slide.index + 1} anzeigen`} aria-current={slide.index === 0 ? "true" : undefined}></button>)}
        </div>
        <p class="gallery__counter" data-gallery-counter>1 / {slides.length}</p>
      </div>
    )}

    <div class="gallery__caption-list">
      {firstSlide.captions.map((item) => (
        <div class="gallery__caption-item">
          {item.titleHtml && <p class="gallery__caption-title" set:html={item.titleHtml}></p>}
          {item.textHtml && <p class="gallery__caption-text" set:html={item.textHtml}></p>}
          {item.href && (
            <a class="gallery__object-link" href={item.href}>
              <span>{item.linkLabel}</span>
              <span class="gallery__object-link-arrow" aria-hidden="true">→</span>
            </a>
          )}
          {item.links?.map((link) => (
            <a class="gallery__object-link" href={link.href}>
              <span>{link.label}</span>
              <span class="gallery__object-link-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>

  <script type="application/json" data-gallery-slides set:html={serializeForScript(slides)}></script>
</section>

<script>
  const renderCaption = (container: HTMLElement, captions: Array<{ titleHtml?: string; textHtml?: string; href?: string; linkLabel?: string; links?: Array<{ href: string; label: string }> }>) => {
    const captionList = document.createElement("div");
    captionList.className = "gallery__caption-list";

    captions.forEach((caption) => {
      const item = document.createElement("div");
      item.className = "gallery__caption-item";

      if (caption.titleHtml) {
        const title = document.createElement("p");
        title.className = "gallery__caption-title";
        title.innerHTML = caption.titleHtml;
        item.append(title);
      }

      if (caption.textHtml) {
        const text = document.createElement("p");
        text.className = "gallery__caption-text";
        text.innerHTML = caption.textHtml;
        item.append(text);
      }

      if (caption.href) {
        const link = document.createElement("a");
        link.className = "gallery__object-link";
        link.href = caption.href;

        const label = document.createElement("span");
        label.textContent = caption.linkLabel ?? "Zum Objekt";

        const arrow = document.createElement("span");
        arrow.className = "gallery__object-link-arrow";
        arrow.setAttribute("aria-hidden", "true");
        arrow.textContent = "→";

        link.append(label, arrow);
        item.append(link);
      }

      caption.links?.forEach((captionLink) => {
        const link = document.createElement("a");
        link.className = "gallery__object-link";
        link.href = captionLink.href;

        const label = document.createElement("span");
        label.textContent = captionLink.label;

        const arrow = document.createElement("span");
        arrow.className = "gallery__object-link-arrow";
        arrow.setAttribute("aria-hidden", "true");
        arrow.textContent = "→";

        link.append(label, arrow);
        item.append(link);
      });

      captionList.append(item);
    });

    const pagination = container.querySelector(".gallery__pagination");
    container.replaceChildren(...[pagination, captionList].filter(Boolean));
  };

  type SlideImage = { src: string; srcset: string; sizes: string; alt: string; peekSrc: string };
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const createImage = (image: SlideImage) => {
    const element = new Image();
    element.className = "gallery__image";
    element.alt = image.alt;
    element.draggable = false;
    element.loading = "eager";
    element.decoding = "async";
    // Set sizes first so preloading selects the same responsive source as display.
    element.sizes = image.sizes;
    element.srcset = image.srcset;
    element.src = image.src;
    return element;
  };

  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const script = gallery.querySelector<HTMLScriptElement>("[data-gallery-slides]");
    const slides = script?.textContent ? JSON.parse(script.textContent) : [];

    if (slides.length <= 1) return;

    const images = gallery.querySelector<HTMLElement>("[data-gallery-images]");
    const previousImage = gallery.querySelector<HTMLImageElement>("[data-gallery-peek-prev-image]");
    const nextImage = gallery.querySelector<HTMLImageElement>("[data-gallery-peek-next-image]");
    const counter = gallery.querySelector<HTMLElement>("[data-gallery-counter]");
    const caption = gallery.querySelector<HTMLElement>("[data-gallery-caption]");
    const previousButton = gallery.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const nextButton = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const previousPeek = gallery.querySelector<HTMLElement>("[data-gallery-peek-prev]");
    const nextPeek = gallery.querySelector<HTMLElement>("[data-gallery-peek-next]");
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-dot]"));
    let activeIndex = 0;
    const mobileViewport = window.matchMedia("(max-width: 767px)");
    let finishTransition = () => {};
    const preparedSlides = new Map<number, HTMLImageElement[]>();
    const pendingSlides = new Map<number, Promise<HTMLImageElement[] | undefined>>();

    const preloadSlide = (index: number): Promise<HTMLImageElement[] | undefined> => {
      if (!slides[index]) return Promise.resolve(undefined);
      const pending = pendingSlides.get(index);
      if (pending) return pending;
      const elements = preparedSlides.get(index) ?? slides[index].images.map(createImage);
      preparedSlides.set(index, elements);
      const ready = Promise.all(elements.map((image: HTMLImageElement) => image.decode()))
        .then(() => elements)
        .catch(() => {
          // A failed speculative load must be retryable on the next interaction.
          preparedSlides.delete(index);
          return undefined;
        })
        .finally(() => pendingSlides.delete(index));
      pendingSlides.set(index, ready);
      return ready;
    };

    if (!images) return;
    preparedSlides.set(0, Array.from(images.querySelectorAll<HTMLImageElement>("img")));

    const mobileTrack = document.createElement("div");
    mobileTrack.className = "gallery__mobile-track";
    mobileTrack.setAttribute("aria-label", "Galeriefolien");
    const mobileSlides = slides.map((slide: { images: SlideImage[] }, index: number) => {
      const container = images.cloneNode(false) as HTMLElement;
      container.removeAttribute("data-gallery-images");
      container.dataset.imageCount = String(slide.images.length);
      container.dataset.mobileSlide = String(index);
      mobileTrack.append(container);
      return container;
    });
    images.after(mobileTrack);
    gallery.dataset.nativeSwipe = "";

    const prepareMobileSlide = (index: number) => {
      if (!slides[index]) return;
      void preloadSlide(index);
      const elements = preparedSlides.get(index)!;
      if (elements[0]?.parentElement !== mobileSlides[index]) mobileSlides[index].replaceChildren(...elements);
    };

    const prepareNeighbours = () => {
      const index = Math.round(mobileTrack.scrollLeft / (mobileTrack.clientWidth || 1));
      [index - 1, index, index + 1].forEach(prepareMobileSlide);
    };

    const updateMobileFade = () => {
      const position = mobileTrack.scrollLeft / (mobileTrack.clientWidth || 1);
      mobileSlides.forEach((container: HTMLElement, index: number) => {
        container.style.opacity = reducedMotion.matches ? "1" : String(Math.max(0, 1 - Math.abs(index - position)));
        container.setAttribute("aria-hidden", String(index !== activeIndex));
      });
    };

    const updateControls = () => {
      const slide = slides[activeIndex];
      const previousSlide = slides[activeIndex - 1];
      const nextSlide = slides[activeIndex + 1];

      if (previousImage && previousSlide) previousImage.src = previousSlide.images[0].peekSrc;
      if (nextImage && nextSlide) nextImage.src = nextSlide.images[0].peekSrc;
      previousPeek?.classList.toggle("is-empty", !previousSlide);
      nextPeek?.classList.toggle("is-empty", !nextSlide);
      if (previousButton) previousButton.disabled = activeIndex === 0;
      if (nextButton) nextButton.disabled = activeIndex === slides.length - 1;
      if (counter) counter.textContent = `${activeIndex + 1} / ${slides.length}`;
      if (caption) renderCaption(caption, slide.captions);

      dots.forEach((dot, index) => {
        const isActive = index === activeIndex;
        dot.toggleAttribute("aria-current", isActive);
      });
    };

    const setSlide = (nextIndex: number) => {
      const target = Math.min(Math.max(nextIndex, 0), slides.length - 1);
      if (mobileViewport.matches) {
        prepareMobileSlide(target);
        activeIndex = target;
        // Buttons jump immediately; touch scrolling and its momentum stay native.
        mobileTrack.scrollTo({ left: target * mobileTrack.clientWidth, behavior: "instant" });
        updateControls();
        updateMobileFade();
        return;
      }
      if (target === activeIndex) return;
      void preloadSlide(target);
      finishTransition();
      const outgoing = !reducedMotion.matches ? images.cloneNode(true) as HTMLElement : undefined;
      const direction = target > activeIndex ? 1 : -1;
      activeIndex = target;
      images.dataset.imageCount = String(slides[target].images.length);
      images.replaceChildren(...preparedSlides.get(target)!);
      if (outgoing) {
        outgoing.removeAttribute("data-gallery-images");
        outgoing.setAttribute("aria-hidden", "true");
        Object.assign(outgoing.style, { position: "absolute", inset: "0", pointerEvents: "none" });
        images.after(outgoing);
        const options = { duration: 60, easing: "ease-out" };
        const animations = [
          outgoing.animate([{ transform: "translateX(0)" }, { transform: `translateX(${-direction * 100}%)` }], options),
          images.animate([{ transform: `translateX(${direction * 100}%)` }, { transform: "translateX(0)" }], options),
        ];
        const cleanup = () => {
          animations.forEach(animation => animation.cancel());
          outgoing.remove();
        };
        finishTransition = cleanup;
        void Promise.all(animations.map(animation => animation.finished)).then(cleanup, cleanup);
      }
      updateControls();
    };

    const syncViewport = () => {
      finishTransition();
      if (mobileViewport.matches) {
        prepareMobileSlide(activeIndex);
        mobileTrack.scrollTo({ left: activeIndex * mobileTrack.clientWidth, behavior: "instant" });
        updateMobileFade();
      } else {
        void preloadSlide(activeIndex);
        images.dataset.imageCount = String(slides[activeIndex].images.length);
        images.replaceChildren(...preparedSlides.get(activeIndex)!);
      }
    };

    // No pointer capture, swipe threshold, release handler, or resize reset:
    // the browser owns the touch gesture and settles at the actual scroll snap.
    mobileTrack.addEventListener("touchstart", prepareNeighbours, { passive: true });
    mobileTrack.addEventListener("pointerdown", prepareNeighbours, { passive: true });
    mobileTrack.addEventListener("scroll", () => {
      if (!mobileViewport.matches || !mobileTrack.clientWidth) return;
      prepareNeighbours();
      const index = Math.min(slides.length - 1, Math.max(0, Math.round(mobileTrack.scrollLeft / mobileTrack.clientWidth)));
      if (index !== activeIndex) {
        activeIndex = index;
        updateControls();
      }
      updateMobileFade();
    }, { passive: true });

    previousButton?.addEventListener("click", () => setSlide(activeIndex - 1));
    nextButton?.addEventListener("click", () => setSlide(activeIndex + 1));
    const preloadOnIntent = (control: HTMLElement | null, index: () => number) => {
      ["pointerenter", "focus", "pointerdown"].forEach((event) => {
        control?.addEventListener(event, () => {
          if (mobileViewport.matches) prepareMobileSlide(index());
          else void preloadSlide(index());
        });
      });
    };
    preloadOnIntent(previousButton, () => activeIndex - 1);
    preloadOnIntent(nextButton, () => activeIndex + 1);
    dots.forEach((dot) => {
      const index = () => Number(dot.dataset.galleryDot ?? 0);
      preloadOnIntent(dot, index);
      dot.addEventListener("click", () => setSlide(index()));
    });
    mobileViewport.addEventListener("change", syncViewport);
    reducedMotion.addEventListener("change", () => {
      if (reducedMotion.matches) finishTransition();
      updateMobileFade();
    });
    syncViewport();
  });
</script>

<style>
  @reference "../../styles/global.css";

  .gallery {
    @apply flex w-full flex-col overflow-hidden text-text-primary;

    background: var(--content-background, var(--chapter-color, var(--color-paper)));
  }

  .gallery__title-section {
    padding: var(--spacing-40) var(--spacing-20) var(--spacing-24);
  }

  .gallery__title {
    @apply font-display text-h1 font-normal text-inherit;

    width: 100%;
    line-height: var(--text-h1--line-height);
  }

  .gallery__stage {
    @apply relative flex w-full items-center;

    padding-inline: var(--spacing-20);
    touch-action: pan-y pinch-zoom;
  }

  .gallery__frame {
    @apply relative m-0 w-full overflow-hidden;
  }

  .gallery__frame :global(.gallery__mobile-track) {
    display: none;
  }

  @media (max-width: 767px) {
    .gallery[data-native-swipe] .gallery__stage {
      touch-action: auto;
    }

    .gallery[data-native-swipe] [data-gallery-images] {
      display: none;
    }

    .gallery__frame :global(.gallery__mobile-track) {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .gallery__frame :global(.gallery__mobile-track::-webkit-scrollbar) {
      display: none;
    }

    .gallery__frame :global([data-mobile-slide]) {
      min-width: 0;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }

  .gallery__mat {
    --gallery-mat-padding: var(--spacing-20);

    @apply flex items-center justify-center overflow-hidden;

    height: 280px;
    gap: var(--spacing-8);
    border: var(--gallery-border-width, 0) solid var(--color-ink);
    background: var(--gallery-mat-background, transparent);
    padding: var(--gallery-mat-padding);
  }

  .gallery__mat :global(.gallery__image) {
    @apply h-full min-w-0 object-contain;

    width: auto;
    max-width: 100%;
    flex: 0 1 auto;
  }

  .gallery__mat[data-image-count="2"] :global(.gallery__image) {
    max-width: calc((100% - var(--spacing-8)) / 2);
  }

  .gallery--wide-image-gap .gallery__mat {
    gap: var(--spacing-24);
  }

  .gallery--wide-image-gap .gallery__mat[data-image-count="2"] :global(.gallery__image) {
    max-width: calc((100% - var(--spacing-24)) / 2);
  }

  .gallery__mat[data-image-count="3"] {
    position: relative;
    display: block;
  }

  .gallery__mat[data-image-count="3"] :global(.gallery__image) {
    position: absolute;
    top: 50%;
    width: 42%;
    height: calc(100% - var(--gallery-mat-padding) * 2);
    max-width: 48%;
    object-fit: contain;
    transform: translateY(-50%);
  }

  .gallery__mat[data-image-count="3"] :global(.gallery__image:nth-child(1)) {
    left: 10%;
    object-position: left center;
  }

  .gallery__mat[data-image-count="3"] :global(.gallery__image:nth-child(2)) {
    z-index: 1;
    left: 50%;
    width: 40%;
    height: 70%;
    max-width: 54%;
    transform: translate(-50%, -50%);
  }

  .gallery__mat[data-image-count="3"] :global(.gallery__image:nth-child(3)) {
    right: 10%;
    object-position: right center;
  }

  .gallery__mat[data-image-count="4"] :global(.gallery__image) {
    max-width: calc((100% - var(--spacing-24)) / 4);
  }

  .gallery__peek,
  .gallery__button {
    @apply hidden;
  }

  .gallery__pagination {
    @apply flex flex-col items-center justify-center text-text-secondary;

    height: 100px;
    gap: var(--spacing-8);
  }

  .gallery__dots {
    @apply flex items-center;

    gap: var(--spacing-8);
  }

  .gallery__dot {
    @apply cursor-pointer border-0 p-0;

    width: 6px;
    height: 6px;
    background: var(--color-ash-grey);
  }

  .gallery__dot[aria-current] {
    background: var(--color-ink);
  }

  .gallery__counter {
    @apply font-sans text-body;

    line-height: var(--text-body--line-height);
  }

