---
import "../styles/global.css";
import Footer from "../components/footer/Footer.astro";
import TopNavigation from "../components/navigation/TopNavigation.astro";
import { pageTitle } from "../data/site";
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="googlebot" content="noindex, nofollow" />
		<meta name="theme-color" content="#f7f7f4" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		<script is:inline>
			try {
				if (localStorage.getItem("hebel-contrast") === "high") {
					document.documentElement.dataset.contrast = "high";
				}
			} catch {}
		</script>
		<title>{pageTitle}</title>
	</head>
	<body>
		<div class="site-shell">
			<TopNavigation />
			<div class="site-main">
				<slot />
			</div>
			<Footer />
		</div>
	</body>
</html>

<script>
	const contrastStorageKey = "hebel-contrast";

	const setContrast = (enabled: boolean, persist = true) => {
		document.documentElement.toggleAttribute("data-contrast", enabled);
		if (enabled) document.documentElement.dataset.contrast = "high";
		document.querySelectorAll<HTMLButtonElement>("[data-contrast-toggle]").forEach((toggle) => {
			toggle.setAttribute("aria-pressed", String(enabled));
		});

		if (!persist) return;
		try {
			localStorage.setItem(contrastStorageKey, enabled ? "high" : "default");
		} catch {}
	};

	setContrast(document.documentElement.dataset.contrast === "high", false);

	document.querySelectorAll<HTMLButtonElement>("[data-contrast-toggle]").forEach((toggle) => {
		toggle.addEventListener("click", () => {
			setContrast(document.documentElement.dataset.contrast !== "high");
			const desktopNavigation = toggle.closest<HTMLElement>(".desktop-navigation");
			if (desktopNavigation) desktopNavigation.dataset.contrastDismissed = "";
			toggle.blur();
		});
	});

	document.querySelectorAll<HTMLElement>(".desktop-navigation").forEach((navigation) => {
		const resetDismissedState = () => delete navigation.dataset.contrastDismissed;

		navigation.addEventListener("pointerleave", resetDismissedState);
		navigation.addEventListener("focusin", (event) => {
			if (!(event.target as Element).closest("[data-contrast-toggle]")) resetDismissedState();
		});
	});

	window.addEventListener("storage", (event) => {
		if (event.key === contrastStorageKey) setContrast(event.newValue === "high", false);
	});
</script>

<style>
	@reference "../styles/global.css";

	.site-shell {
		@apply flex flex-col;

		min-height: 100vh;
	}

	.site-main {
		@apply flex-1;
	}
</style>
