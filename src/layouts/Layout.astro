---
import type { ImageMetadata } from "astro";
import "../styles/global.css";
import Footer from "../components/footer/Footer.astro";
import TopNavigation from "../components/navigation/TopNavigation.astro";
import defaultSocialImage from "../assets/Meta/Hebel_Portraet_Homepage.png";
import { homeDescription, pageTitle, productionUrl, seoSiteName } from "../data/site";

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	image?: ImageMetadata | string;
	imageAlt?: string;
	keywords?: string[];
}

const {
	title = pageTitle,
	description = homeDescription,
	canonicalPath = Astro.url.pathname,
	image = defaultSocialImage,
	imageAlt = "Porträt Johann Peter Hebels nach einem Kupferstich von Johann Friedrich Müller",
	keywords = [],
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, `${productionUrl}/`).href;
const imagePath = typeof image === "string" ? image : image.src;
const imageUrl = new URL(imagePath, `${productionUrl}/`).href;
const imageWidth = typeof image === "string" ? undefined : image.width;
const imageHeight = typeof image === "string" ? undefined : image.height;
const keywordContent = keywords.map((keyword) => keyword.trim()).filter(Boolean).join(", ");
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="index, follow" />
		<meta name="googlebot" content="index, follow" />
		<meta name="description" content={description} />
		{keywordContent && <meta name="keywords" content={keywordContent} />}
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={seoSiteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
		{imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<meta name="theme-color" content="#f7f7f4" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		<script is:inline>
			try {
				if (localStorage.getItem("hebel-contrast") === "high") {
					document.documentElement.dataset.contrast = "high";
				}
			} catch {}
		</script>
		<title>{title}</title>
	</head>
	<body>
		<div class="site-shell">
			<TopNavigation />
			<div class="site-main">
				<slot />
			</div>
			<Footer />
		</div>
	</body>
</html>

<script>
	const contrastStorageKey = "hebel-contrast";

	const setContrast = (enabled: boolean, persist = true) => {
		document.documentElement.toggleAttribute("data-contrast", enabled);
		if (enabled) document.documentElement.dataset.contrast = "high";
		document.querySelectorAll<HTMLButtonElement>("[data-contrast-toggle]").forEach((toggle) => {
			toggle.setAttribute("aria-pressed", String(enabled));
		});

		if (!persist) return;
		try {
			localStorage.setItem(contrastStorageKey, enabled ? "high" : "default");
		} catch {}
	};

	setContrast(document.documentElement.dataset.contrast === "high", false);

	document.querySelectorAll<HTMLButtonElement>("[data-contrast-toggle]").forEach((toggle) => {
		toggle.addEventListener("click", () => {
			setContrast(document.documentElement.dataset.contrast !== "high");
			const desktopNavigation = toggle.closest<HTMLElement>(".desktop-navigation");
			if (desktopNavigation) desktopNavigation.dataset.contrastDismissed = "";
			toggle.blur();
		});
	});

	document.querySelectorAll<HTMLElement>(".desktop-navigation").forEach((navigation) => {
		const resetDismissedState = () => delete navigation.dataset.contrastDismissed;

		navigation.addEventListener("pointerleave", resetDismissedState);
		navigation.addEventListener("focusin", (event) => {
			if (!(event.target as Element).closest("[data-contrast-toggle]")) resetDismissedState();
		});
	});

	window.addEventListener("storage", (event) => {
		if (event.key === contrastStorageKey) setContrast(event.newValue === "high", false);
	});
</script>

<style>
	@reference "../styles/global.css";

	.site-shell {
		@apply flex flex-col;

		min-height: 100vh;
		min-height: 100lvh;
	}

	.site-main {
		@apply flex-1;
	}
</style>
