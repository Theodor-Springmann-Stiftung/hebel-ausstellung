---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import PageNavigation from '../../components/navigation/PageNavigation.astro';
import SectionGalleries from '../../components/chapter/SectionGalleries.astro';
import SubchapterHero from '../../components/chapter/SubchapterHero.astro';
import { exhibitionCredit, pageTitle } from '../../data/site';
import { chapterHref, getReadingOrder, getSubchapterRoutes, subchapterHref } from '../../lib/content';
import { markdownToPlainText } from '../../lib/markdown';
import { getDedicatedHeroImage, resolveContentImage } from '../../lib/object-images';

export const getStaticPaths = getSubchapterRoutes;

const { chapter, subchapter } = Astro.props;
const chapterLabel = `Kapitel ${Number(chapter.data.nummer)}: ${chapter.data.navTitel}`;
const subchapterTitle = markdownToPlainText(subchapter.data.titel);
const title = `Kapitel ${subchapter.data.nummer}: ${subchapterTitle}. ${pageTitle}`;
const description = `Kapitel ${subchapter.data.nummer} – ${subchapterTitle} – ${exhibitionCredit}`;
const heroImage = getDedicatedHeroImage(subchapter.data.hero);
const heroMetadata = subchapter.data.heroMetadata ? await resolveContentImage(subchapter.data.heroMetadata) : undefined;
const heroAlt = markdownToPlainText(
	heroMetadata?.entry?.data.beschriftung
		?? heroMetadata?.entry?.data.altText
		?? subchapter.data.titel,
);
const galleryIds = new Set((await getCollection('galleries')).map((gallery) => gallery.id));
const hasCompleteGallerySet = subchapter.data.galerien.every((reference) => galleryIds.has(reference.id));
const readingOrder = await getReadingOrder();
const readingIndex = readingOrder.findIndex((section) => section.kind === 'subchapter' && section.id === subchapter.id);
const previousSection = readingIndex > 0 ? readingOrder[readingIndex - 1] : undefined;
const nextSection = readingIndex >= 0 ? readingOrder[readingIndex + 1] : undefined;
---

<Layout title={title} description={description} image={heroImage} imageAlt={heroAlt}>
	<main role="main" class="subchapter-page" style={`--chapter-color: var(--chapter-${Number(chapter.data.nummer)}); --chapter-color-medium: var(--chapter-${Number(chapter.data.nummer)}-medium); --chapter-color-vibrant: var(--chapter-${Number(chapter.data.nummer)}-vibrant); --chapter-color-dark: var(--chapter-${Number(chapter.data.nummer)}-dark); --page-background: var(--chapter-color)`}>
		<Breadcrumbs
			items={[
				{ label: 'Startseite', href: '/' },
				{ label: chapterLabel, href: chapterHref(chapter.data.nummer) },
				{ label: subchapter.data.navTitel },
			]}
		/>
		<SubchapterHero chapter={chapter} subchapter={subchapter} />
		{hasCompleteGallerySet && <SectionGalleries section={subchapter} />}
		<PageNavigation
			previous={previousSection}
			next={nextSection}
		/>
	</main>
</Layout>

<style>
	.subchapter-page {
		background: var(--page-background);
	}
</style>
