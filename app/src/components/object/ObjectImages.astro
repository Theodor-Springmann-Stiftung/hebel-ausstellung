---
import { markdownToPlainText } from "../../lib/markdown";
import { getObjectImage, type ObjectDisplayImage } from "../../lib/object-images";
import ObjectImageCarousel from "./ObjectImageCarousel.astro";

const { images } = Astro.props as { images: ObjectDisplayImage[] };
const imageItems = images.map((image) => {
  const asset = getObjectImage(image.dateiname ?? image.id);

  return { image, asset };
});
const hasMultipleImages = imageItems.length > 1;
const shouldUseCarousel = hasMultipleImages;
const carouselImages = imageItems.map(({ image, asset }) => ({ key: image.key, asset, alt: markdownToPlainText(image.altText) }));
const singleImage = imageItems[0];
---

{hasMultipleImages && (
  <div class="object-images object-images--compact-carousel">
    <ObjectImageCarousel images={carouselImages} syncId="responsive-object-images" />
  </div>
)}

{shouldUseCarousel && (
  <div class="object-images object-images--desktop-only">
    <ObjectImageCarousel images={carouselImages} syncId="responsive-object-images" />
  </div>
)}

{!shouldUseCarousel && singleImage && (
  <div class="object-images">
    <figure class="object-images__frame">
      <img
        class="object-images__image"
        src={singleImage.asset.src}
        alt={markdownToPlainText(singleImage.image.altText)}
        width={singleImage.asset.width}
        height={singleImage.asset.height}
        loading="eager"
        decoding="async"
      />
    </figure>
  </div>
)}

<style>
  @reference "../../styles/global.css";

  .object-images {
    @apply flex flex-col;

    gap: var(--spacing-24);
    padding-inline: var(--spacing-20);
  }

  .object-images--desktop-only {
    display: none;
  }

  .object-images__frame {
    @apply m-0 flex items-center justify-center overflow-hidden bg-oat;

    width: 100%;
    height: auto;
    gap: var(--spacing-20);
    border: 0.5px solid var(--color-ink);
    padding: var(--spacing-32) var(--spacing-20);
  }

  .object-images__image {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .object-images {
      padding-inline: var(--spacing-32);
    }

    .object-images__frame {
      height: 1000px;
      gap: var(--spacing-32);
      padding-inline: var(--spacing-32);
    }

    .object-images__image {
      height: 100%;
    }
  }

  @media (min-width: 1440px) {
    .object-images--compact-carousel {
      display: none;
    }

    .object-images--desktop-only {
      display: flex;
    }

    .object-images {
      padding-inline: var(--spacing-80);
    }

    .object-images__frame {
      height: 1000px;
      gap: var(--spacing-40);
      padding-inline: var(--spacing-40);
    }

    .object-images__image {
      height: 100%;
    }
  }
</style>
